---
import '../styles/global.css';
import '../styles/hatches.css';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import TargetHover from '../components/ui/TargetHover.astro';
import { siteUrl, siteName } from '../lib/site';
import { defaultLocale, languages, localeNames, ogLocales, translatePath, ui, type Locale } from '../i18n/ui';
import portrait from '../assets/me.png';
import manropeLatinUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import frauncesLatinUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
}

const portraitOg = await getImage({
  src: portrait,
  format: 'webp',
  width: 1200,
  height: 630,
  fit: 'cover',
});

const {
  title,
  description,
  locale = defaultLocale,
  image = portraitOg.src,
  type = 'website',
  robots = 'index, follow',
} = Astro.props;

const lang = localeNames[locale];
const ogLocale = ogLocales[locale];
const t = ui[locale];

const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(canonicalPath === '/' ? '/' : `${canonicalPath}/`, siteUrl).toString();

const getAlternatePath = (target: Locale): string =>
  translatePath(Astro.url.pathname, target);

const localesList = Object.keys(languages) as Locale[];
const ogAlternateLocales = localesList
  .filter((target) => target !== locale)
  .map((target) => ogLocales[target]);

const hreflangLinks = localesList.map(
  (target) => new URL(getAlternatePath(target), siteUrl).toString(),
);
const hreflangCodes = localesList.map((target) => localeNames[target]);

const ogImage = new URL(image, siteUrl).toString();
const ogImageMeta = image === portraitOg.src
  ? { width: 1200, height: 630, alt: t.ogImageAlt }
  : { width: undefined, height: undefined, alt: undefined };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <!-- Hreflang / i18n -->
    {localesList.map((_, i) => (
      <link rel="alternate" hreflang={hreflangCodes[i]} href={hreflangLinks[i]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl).toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {ogImageMeta.width && <meta property="og:image:width" content={String(ogImageMeta.width)} />}
    {ogImageMeta.height && <meta property="og:image:height" content={String(ogImageMeta.height)} />}
    {ogImageMeta.alt && <meta property="og:image:alt" content={ogImageMeta.alt} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternateLocales.map((alt) => (
      <meta property="og:locale:alternate" content={alt} />
    ))}
    <meta property="og:url" content={canonical} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Preload das woff2 críticas: manrope-latin (corpo) e fraunces-latin
        (serif para blockquote/hero-display). As URLs com hash casam com os
        @font-face em global.css (ambos apontam para o mesmo chunk em
        dist/_astro/). */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href={manropeLatinUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesLatinUrl} />

    <script is:inline>
      // Apply theme before first paint to avoid FOUC.
      (() => {
        const root = document.documentElement;
        const stored = (() => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        })();
        const theme = stored === 'light' || stored === 'dark'
          ? stored
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        root.classList.toggle('dark', theme === 'dark');
        root.classList.add('theme-applied');
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <div class="screen-fade screen-fade-top" aria-hidden="true" />
    <a
      class="skip-link"
      href="#main-content"
      aria-label={t.skipLink}
    >
      {t.skipLink}
    </a>
    <Header locale={locale} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer locale={locale} />
    <TargetHover
      hoverDuration={0.2}
      parallaxOn={true}
      parallaxStrength={7}
      cornerSize={12}
      borderWidth={2}
      offset={8}
    />
    <div class="screen-fade screen-fade-bottom" aria-hidden="true" />
  </body>
</html>
