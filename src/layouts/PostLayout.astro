---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import Sep from '../components/ui/Sep.astro';
import { TYPE } from '../components/ui/typography';
import TargetSimbol from '../components/ui/TargetSimbol.astro';
import { getReadingTime, formatDate, getPostSlug } from '../lib/posts';
import { siteUrl, authorName } from '../data/site';
import { defaultLocale, ui, type Locale } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  locale?: Locale;
}

const { post, locale = defaultLocale } = Astro.props;
const t = ui[locale];
const { data } = post;
const { title, description, pubDate, updatedDate, tags } = data;
const readingTime = getReadingTime(post);
const baseUrl = locale === defaultLocale ? '' : `/${locale}`;
const pageUrl = new URL(`${baseUrl}/blog/${getPostSlug(post)}`, siteUrl).toString();

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: locale,
  author: {
    '@type': 'Person',
    name: authorName,
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: authorName,
    url: siteUrl,
  },
  image: data.cover ?? undefined,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.homeLink, item: new URL(baseUrl || '/', siteUrl).toString() },
    { '@type': 'ListItem', position: 2, name: t.navBlog, item: new URL(`${baseUrl}/blog`, siteUrl).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const shareUrl = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(title);
---

<BaseLayout
  title={`${title} — ${authorName}`}
  description={description}
  type="article"
  image={data.cover ?? undefined}
  locale={locale}
>
  <JsonLd slot="head" schema={blogPostingJsonLd} />
  <JsonLd slot="head" schema={breadcrumbJsonLd} />

  <article class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8 pb-16 pt-12 sm:pt-16">
    <header class="mx-auto mb-10 max-w-[70ch]">
      <p class="mb-4">
        <a
          href={`${baseUrl}/blog`}
          class={`cursor-target group transition-micro inline-flex min-h-11 items-center gap-2 ${TYPE.label} text-muted-foreground hover:text-foreground`}
        >
          {t.backToBlog}
          <TargetSimbol size={25} class="md:hidden" />
        </a>
      </p>
      <h1 class={`mb-4 ${TYPE.titleH1}`}>{title}</h1>
      <p class={`mb-4 ${TYPE.body} text-muted-foreground`}>{description}</p>
      <div class={`flex flex-wrap items-center gap-x-4 gap-y-2 ${TYPE.label} text-muted-foreground`}>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, locale)}</time>
        <Sep />
        <span>{t.readingTime.replace('{count}', String(readingTime))}</span>
        {updatedDate && (
          <>
            <Sep />
            <time datetime={updatedDate.toISOString()}>{t.updatedLabel} {formatDate(updatedDate, locale)}</time>
          </>
        )}
      </div>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class={`rounded-lg border border-border px-2 py-0.5 ${TYPE.label} text-muted-foreground`}>
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="post-content mx-auto">
      <slot />
    </div>

    <footer class="mx-auto mt-12 max-w-[70ch] border-t border-border pt-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p class={`${TYPE.label} text-muted-foreground`}>
          {t.share}
        </p>
        <div class="flex gap-4">
          <a
            href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`cursor-target group transition-micro flex min-h-11 items-center gap-2 ${TYPE.label} text-muted-foreground hover:text-foreground`}
          >
            {t.shareX}
            <TargetSimbol size={25} class="md:hidden" />
          </a>
          <a
            href={`mailto:?subject=${shareText}&body=${shareUrl}`}
            class={`cursor-target group transition-micro flex min-h-11 items-center gap-2 ${TYPE.label} text-muted-foreground hover:text-foreground`}
          >
            {t.shareEmail}
            <TargetSimbol size={25} class="md:hidden" />
          </a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>