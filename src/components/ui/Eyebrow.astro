---
import Text from './Text.astro';
import Sep from './Sep.astro';

interface Props {
  label: string;
  label2?: string;
  class?: string;
}

const { label, label2, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 border border-border bg-background/60 px-2 py-[0.3125rem] text-muted-foreground',
    className,
  ]}
>
  <slot name="icon" />
  <Text variant="label">{label}</Text>
  {label2 && <Sep class="mx-1" />}
  {label2 && <Text variant="label">{label2}</Text>}
</span>
</span>
