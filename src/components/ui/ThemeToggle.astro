---
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale].themeToggle;
---

<button
  type="button"
  class="theme-toggle cursor-pointer flex min-h-11 min-w-11 items-center justify-center rounded-full bg-foreground/30 text-background transition-all duration-200"
  data-label-dark={t.toDark}
  data-label-light={t.toLight}
  aria-label={t.toDark}
  aria-pressed="false"
  title={t.title}
>
  <svg
    width="36"
    height="36"
    viewBox="0 0 240 240"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
      <g class="theme-toggle-halves">
        <path
          d="M120 67.5C149.25 67.5 172.5 90.75 172.5 120C172.5 149.25 149.25 172.5 120 172.5"
          fill="currentColor"
            opacity="0.9"
        />
        <path
          d="M120 67.5C90.75 67.5 67.5 90.75 67.5 120C67.5 149.25 90.75 172.5 120 172.5"
          fill="var(--foreground)"
          opacity="0.9"
        />
      </g>
      <path
        class="theme-toggle-ring"
        d="M120 3.75C55.5 3.75 3.75 55.5 3.75 120C3.75 184.5 55.5 236.25 120 236.25C184.5 236.25 236.25 184.5 236.25 120C236.25 55.5 184.5 3.75 120 3.75ZM120 214.5V172.5C90.75 172.5 67.5 149.25 67.5 120C67.5 90.75 90.75 67.5 120 67.5V25.5C172.5 25.5 214.5 67.5 214.5 120C214.5 172.5 172.5 214.5 120 214.5Z"
        fill="currentColor"
        opacity="0.9"
      />
  </svg>
</button>

<style>
  /* Port CSS do motion.g/motion.path do ThemeToggleButton1 (draft
     docs/drafts/theme-toggle-i-want.ts). A classe .is-dark é aplicada por
     theme-toggle.ts. */
  .theme-toggle-halves,
  .theme-toggle-ring {
    transform-box: view-box;
    transform-origin: 120px 120px;
    transition: transform 0.35s ease-in-out;
  }

  .theme-toggle.is-dark .theme-toggle-halves {
    transform: rotate(-180deg);
  }

  .theme-toggle.is-dark .theme-toggle-ring {
    transform: rotate(180deg);
  }
</style>

<script>
  import './theme-toggle';
</script>