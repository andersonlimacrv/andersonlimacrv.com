---
/**
 * Subtitle — Rótulo mono reutilizável para toda a página
 *
 * Padroniza o padrão visual usado em About (Role, Main stack, Localização,
 * Sobre mim, Redes sociais) e Trajectory (Trabalho/Formação) com as mesmas
 * specs do design system: font-mono, uppercase, tracking, muted-foreground,
 * responsivo 7px → 9px.
 *
 * Props:
 * - label: texto (já traduzido via ui[locale])
 * - as: elemento semântico (p, dt, h3, span) — mantém a11y
 * - variant: 'muted' (padrão, 60% opacity) ou 'strong' (sem opacity, para headers)
 * - id: opcional para aria-labelledby
 */
interface Props {
  label: string;
  as?: 'p' | 'dt' | 'h3' | 'span' | 'h2';
  variant?: 'muted' | 'strong';
  size?: 'xs' | 'sm';
  id?: string;
  class?: string;
}

const { label, as: Tag = 'p', variant = 'muted', size = 'xs', id, class: className } = Astro.props as Props;

const base = 'font-mono uppercase';
const sizeClass = size === 'sm' ? 'text-[9px] sm:text-[10px] tracking-[0.2em]' : 'text-[7px] sm:text-[9px] tracking-[0.18em]';
const color = variant === 'muted' ? 'text-muted-foreground/60' : 'text-muted-foreground';
---

<Tag id={id} class:list={[base, sizeClass, color, className]}>
  {label}
</Tag>
