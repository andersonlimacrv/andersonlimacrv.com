---
import KineticGrid from '../ui/KineticGrid.astro';
interface Props {
  number: string;
  title: string;
  id?: string;
  eyebrow?: string;
}

const { number, title, id, eyebrow } = Astro.props;
const titleId = id ? `${id}-title` : undefined;
---

<section id={id} aria-labelledby={titleId} class="scroll-mt-24 py-16 sm:py-20">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    <div class="">
        <KineticGrid class="h-60 border border-border" globalColor="default">
    <div class="flex items-center justify-center gap-x-4">
         {eyebrow && <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">{eyebrow}</p>}
      <span class="shrink-0 font-mono text-sm font-semibold tracking-[0.01em] text-primary text-[120px]">{number}</span>
      <span class="h-px flex-1 " aria-hidden="true"></span>
      <h2 id={titleId} class="font-sans text-h1 font-bold uppercase leading-[1.1] tracking-tight">[{title}]</h2>
    </div>
    </KineticGrid>
        

    </div>
  
    <div class="">
      <slot />
    </div>
  </div>
</section>
