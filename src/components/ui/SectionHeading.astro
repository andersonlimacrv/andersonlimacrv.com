---
import { TYPE } from '../ui/typography';
import KineticGrid from '../ui/KineticGrid.astro';
import TextScramble from '../ui/TextScramble.astro';

interface Props {
  number: string;
  title: string;
  id?: string;
  eyebrow?: string;
}

const { number, title, id, eyebrow } = Astro.props;
const titleId = id ? `${id}-title` : undefined;
---

<section id={id} aria-labelledby={titleId} class="scroll-mt-24 py-16 sm:py-20">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
        <KineticGrid class="h-50 border border-border px-4" globalColor="default">
            <div class="flex h-full items-center justify-center gap-x-4">
                <div class="flex flex-col items-center">
                    {eyebrow && <p class={`w-full text-center ${TYPE.sectionEyebrow} text-muted-foreground`}>{eyebrow}</p>}
                    <span class={`${TYPE.sectionNumber} text-primary`}>{number}</span>
                </div>
                <span class="h-px flex-1 " aria-hidden="true"></span>
                <h2 id={titleId} class={`shrink-0 ${TYPE.sectionTitle}`}>[<TextScramble text={title} variant="sectionTitle" />]</h2>
            </div>
        </KineticGrid>
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>