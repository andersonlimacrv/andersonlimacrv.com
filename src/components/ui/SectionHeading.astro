---
interface Props {
  number: string;
  title: string;
  id?: string;
  eyebrow?: string;
}

const { number, title, id, eyebrow } = Astro.props;
const titleId = id ? `${id}-title` : undefined;
---

<section id={id} aria-labelledby={titleId} class="scroll-mt-24 py-16 sm:py-20">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    {eyebrow && <p class="mb-4 font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">{eyebrow}</p>}
    <div class="flex items-center gap-4">
      <span class="shrink-0 font-mono text-sm font-semibold tracking-[0.16em] text-primary">{number}</span>
      <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
      <h2 id={titleId} class="font-sans text-h1 font-bold leading-[1.1] tracking-tight">{title}</h2>
    </div>
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
