---
import KineticGrid from '../ui/KineticGrid.astro';
interface Props {
  number: string;
  title: string;
  id?: string;
  eyebrow?: string;
}

const { number, title, id, eyebrow } = Astro.props;
const titleId = id ? `${id}-title` : undefined;
---

<section id={id} aria-labelledby={titleId} class="scroll-mt-24 py-16 sm:py-20">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
        <KineticGrid class="h-50 border border-border px-4" globalColor="default">
            <div class="flex h-full items-center justify-center gap-x-4">
                <div class="flex flex-col items-center">
                    {eyebrow && <p class="w-full text-center font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">{eyebrow}</p>}
                    <span class="font-mono text-[90px] md:text-[120px] font-semibold leading-none tracking-[0.01em] text-primary">{number}</span>
                </div> 
                <span class="h-px flex-1 " aria-hidden="true"></span>
                <h2 id={titleId} class="font-sans text-h1 font-bold uppercase leading-[1.1] tracking-tight">[{title}]</h2>
            </div>
        </KineticGrid>
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
