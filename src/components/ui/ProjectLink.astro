---
import { TYPE } from './typography';

interface Props {
  title: string;
  description?: string;
  url: string;
  tags?: readonly string[];
  external?: boolean;
}

const { title, description, url, tags = [], external = true } = Astro.props;
---

<a
  href={url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="cursor-target transition-micro flex min-h-11 flex-col gap-2 border border-border p-5"
>
  <span class="flex items-center justify-between gap-3">
    <span class={`${TYPE.titleH3}`}>{title}</span>
  </span>
  {description && <span class={`${TYPE.body} text-muted-foreground`}>{description}</span>}
  {tags.length > 0 && (
    <span class="mt-1 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class={`border border-border px-2 py-0.5 ${TYPE.label} text-muted-foreground`}>
          {tag}
        </span>
      ))}
    </span>
  )}
</a>
