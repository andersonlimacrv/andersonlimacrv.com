---
import { TYPE, type Variant } from './typography';

interface Props {
  text: string;
  variant?: Variant;
  as?: any;
  id?: string;
  class?: string;
  chars?: string;
  speed?: number;
  onHover?: boolean;
  onEntry?: boolean;
}

const {
  text,
  variant = 'body',
  as: Tag = 'span',
  id,
  class: className = '',
  chars = '!<>-_\\/[]{}—=+*^?#________',
  speed = 1,
  onHover = false,
  onEntry = true,
} = Astro.props as Props;
const typeClass = TYPE[variant] ?? TYPE.body;
---

<Tag
  id={id}
  class:list={[typeClass, className]}
  data-text-scramble
  data-text={text}
  data-chars={chars}
  data-speed={speed}
  data-on-hover={onHover}
  data-on-entry={onEntry}
>
  {text}
</Tag>

<style>
  [data-text-scramble] :global(.scramble-dud) {
    color: var(--muted-foreground);
    opacity: 0.8;
  }
</style>

<script>
  import './text-scramble';
</script>
