---
import { TYPE } from './typography';

interface Props {
  variant?: string;
  id?: string;
  class?: string;
}

const {
  variant = 'body',
  id,
  class: className = '',
} = Astro.props as Props;
const typeClass = (TYPE as Record<string, string>)[variant];
---

<span id={id} class:list={[typeClass, className]}>
  <slot />
</span>