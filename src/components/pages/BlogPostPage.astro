---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import TargetSimbol from '../ui/TargetSimbol.astro';
import { TYPE } from '../ui/typography';
import { getPublishedPosts, getRelatedPosts, getPostSlug, formatDate, type BlogPost } from '../../lib/posts';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale = defaultLocale } = Astro.props;
const t = ui[locale];
const allPosts = await getPublishedPosts(locale);
const related = getRelatedPosts(post, allPosts, 3);
const { Content } = await render(post);
const baseUrl = locale === defaultLocale ? '' : `/${locale}`;
---

<PostLayout post={post} locale={locale}>
  <Content />
  {related.length > 0 && (
    <aside class="mt-14 border-t border-border pt-10">
      <h2 class={`mb-2 ${TYPE.labelWide} text-muted-foreground`}>
        {t.relatedPosts}
      </h2>
      <ol class="flex flex-col divide-y divide-border">
        {related.map((relatedPost, i) => (
          <li>
            <a
              href={`${baseUrl}/blog/${getPostSlug(relatedPost)}`}
              class="cursor-target group transition-micro flex min-h-11 items-baseline gap-x-4 py-5"
            >
              <span
                aria-hidden="true"
                class={`shrink-0 ${TYPE.label} text-muted-foreground`}
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class={`min-w-0 flex-1 transition-micro group-hover:text-primary ${TYPE.titleH3}`}>
                {relatedPost.data.title}
              </span>
              <TargetSimbol size={16} class="shrink-0 self-center sm:hidden" />
              <span
                aria-hidden="true"
                class={`shrink-0 self-center ${TYPE.label} text-muted-foreground transition-micro group-hover:translate-x-1 group-hover:text-foreground`}
              >&rarr;</span>
              <time
                datetime={relatedPost.data.pubDate.toISOString()}
                class={`hidden shrink-0 self-center ${TYPE.label} text-muted-foreground sm:inline`}
              >
                {formatDate(relatedPost.data.pubDate, locale)}
              </time>
            </a>
          </li>
        ))}
      </ol>
    </aside>
  )}
</PostLayout>
