---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../PostCard.astro';
import Reveal from '../Reveal.astro';
import JsonLd from '../JsonLd.astro';
import { getPublishedPosts } from '../../lib/posts';
import { siteUrl } from '../../lib/site';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui[locale];
const posts = await getPublishedPosts(locale);
const baseUrl = locale === defaultLocale ? '' : `/${locale}`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.homeLink,
      item: new URL(baseUrl || '/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.navBlog,
      item: new URL(`${baseUrl}/blog`, siteUrl).toString(),
    },
  ],
};
---

<BaseLayout
  title={t.meta.blogTitle}
  description={t.meta.blogDescription}
  locale={locale}
>
  <JsonLd schema={breadcrumbJsonLd} />

  <div class="container-site pb-16 pt-12 sm:pt-16">
    <p class="mb-6 font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
      {t.blogLabel}
    </p>
    <h1 class="heading-display mb-10">{t.blogTitle}</h1>

    {posts.length > 0 ? (
      <Reveal>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} locale={locale} />
          ))}
        </div>
      </Reveal>
    ) : (
      <p class="text-muted-foreground">
        {t.noPosts}
      </p>
    )}
  </div>
</BaseLayout>