---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../ui/PostCard.astro';
import Reveal from '../ui/Reveal.astro';
import { TYPE } from '../ui/typography';
import JsonLd from '../ui/JsonLd.astro';
import { getPublishedPosts } from '../../lib/posts';
import { siteUrl } from '../../data/site';
import { defaultLocale, translateTitle, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui[locale];
const posts = await getPublishedPosts(locale);
const baseUrl = locale === defaultLocale ? '' : `/${locale}`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.homeLink,
      item: new URL(baseUrl || '/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.navBlog,
      item: new URL(`${baseUrl}/blog`, siteUrl).toString(),
    },
  ],
};
---

<BaseLayout
  title={translateTitle(t.meta.blogTitle)}
  description={t.meta.blogDescription}
  locale={locale}
>
  <JsonLd slot="head" schema={breadcrumbJsonLd} />

  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8 pb-16 pt-12 sm:pt-16">
    <p class={`mb-6 ${TYPE.labelWide} text-muted-foreground`}>
      {t.blogLabel}
    </p>
    <h1 class={`mb-10 ${TYPE.titleH1}`}>{t.blogTitle}</h1>

    {posts.length > 0 ? (
      <Reveal>
        <div class="flex flex-col divide-y divide-border">
          {posts.map((post) => (
            <PostCard post={post} locale={locale} />
          ))}
        </div>
      </Reveal>
    ) : (
      <p class="text-muted-foreground">
        {t.noPosts}
      </p>
    )}
  </div>
</BaseLayout>