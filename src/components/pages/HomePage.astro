---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../ui/JsonLd.astro';
import ElasticLine from '../ui/ElasticLine.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Projects from '../sections/Projects.astro';
import Blog from '../sections/Blog.astro';
import Contact from '../sections/Contact.astro';
import portrait from '../../assets/me.png';
import { siteUrl, socialLinks, authorName } from '../../lib/site';
import { profile } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui[locale];

const portraitMeta = await getImage({
  src: portrait,
  format: 'webp',
  width: 1122,
});

const baseUrl = locale === defaultLocale ? '' : `/${locale}`;
const homeUrl = `${baseUrl}/`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: authorName,
  url: new URL(homeUrl, siteUrl).toString(),
  image: new URL(portraitMeta.src, siteUrl).toString(),
  jobTitle: profile.hero.title,
  description: profile.hero.bio,
  sameAs: [socialLinks.github, socialLinks.linkedin],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Anderson Carvalho',
  url: siteUrl,
  inLanguage: locale,
};
---

<BaseLayout
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  locale={locale}
>
  <JsonLd slot="head" schema={personJsonLd} />
  <JsonLd slot="head" schema={websiteJsonLd} />

  <Hero locale={locale} />

  <!-- Divisor elástico: hero | sobre — reage ao ponteiro. Apague estas
       4 linhas (ElasticLine) para remover os divisores por completo. -->
  <ElasticLine class="h-16 text-muted-foreground" strokeWidth={1} releaseThreshold={50} />

  <About locale={locale} />

  <ElasticLine class="h-16 text-muted-foreground" strokeWidth={1} releaseThreshold={50} />

  <Projects locale={locale} />

  <ElasticLine class="h-16 text-muted-foreground" strokeWidth={1} releaseThreshold={50} />

  <Blog locale={locale} />

  <ElasticLine class="h-16 text-muted-foreground" strokeWidth={1} releaseThreshold={50} />

  <Contact locale={locale} />
</BaseLayout>