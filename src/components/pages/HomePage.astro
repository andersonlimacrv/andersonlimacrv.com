---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../ui/JsonLd.astro';
import ElasticLine from '../ui/ElasticLine.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Projects from '../sections/Projects.astro';
import Blog from '../sections/Blog.astro';
import Contact from '../sections/Contact.astro';
import portrait from '../../assets/me.png';
import { siteUrl, site, socialLinks, authorName } from '../../data/site';
import { profile } from '../../data/profile';
import { defaultLocale, translateTitle, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui[locale];

const portraitMeta = await getImage({
  src: portrait,
  format: 'webp',
  width: 1122,
});

const baseUrl = locale === defaultLocale ? '' : `/${locale}`;
const homeUrl = `${baseUrl}/`;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: authorName,
  url: new URL(homeUrl, siteUrl).toString(),
  image: new URL(portraitMeta.src, siteUrl).toString(),
  jobTitle: profile.hero.title,
  description: profile.hero.bio,
  sameAs: [socialLinks.github, socialLinks.linkedin],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: siteUrl,
  inLanguage: locale,
};
---

<BaseLayout
  title={translateTitle(t.meta.homeTitle)}
  description={t.meta.homeDescription}
  locale={locale}
>
  <JsonLd slot="head" schema={personJsonLd} />
  <JsonLd slot="head" schema={websiteJsonLd} />

  <div class="relative mx-auto w-full max-w-6xl">
    <div class="relative">
      <ElasticLine
        isVertical
        class="pointer-events-none absolute left-0 top-0 hidden h-[calc(100%+32px)] w-10 -translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <ElasticLine
        isVertical
        class="pointer-events-none absolute right-0 top-0 hidden h-[calc(100%+32px)] w-10 translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <Hero locale={locale} />
    </div>
    <ElasticLine class="h-16 text-border" strokeWidth={1.6} releaseThreshold={50} />
    <div class="relative">
      <ElasticLine
        isVertical
        class="pointer-events-none absolute left-0 -top-8 hidden h-[calc(100%+64px)] w-10 -translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <ElasticLine
        isVertical
        class="pointer-events-none absolute right-0 -top-8 hidden h-[calc(100%+64px)] w-10 translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <About locale={locale} />
    </div>

    <ElasticLine class="h-16 text-border" strokeWidth={1.6} releaseThreshold={50} />
    <div class="relative">
      <ElasticLine
        isVertical
        class="pointer-events-none absolute left-0 -top-8 hidden h-[calc(100%+64px)] w-10 -translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <ElasticLine
        isVertical
        class="pointer-events-none absolute right-0 -top-8 hidden h-[calc(100%+64px)] w-10 translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <Projects locale={locale} />
    </div>

    <ElasticLine class="h-16 text-border" strokeWidth={1.6} releaseThreshold={50} />
    <div class="relative">
      <ElasticLine
        isVertical
        class="pointer-events-none absolute left-0 -top-8 hidden h-[calc(100%+64px)] w-10 -translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <ElasticLine
        isVertical
        class="pointer-events-none absolute right-0 -top-8 hidden h-[calc(100%+64px)] w-10 translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <Blog locale={locale} />
    </div>

    <ElasticLine class="h-16 text-border" strokeWidth={1.6} releaseThreshold={50} />
    <div class="relative">
      <ElasticLine
        isVertical
        class="pointer-events-none absolute left-0 -top-8 hidden h-[calc(100%+32px)] w-10 -translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <ElasticLine
        isVertical
        class="pointer-events-none absolute right-0 -top-8 hidden h-[calc(100%+32px)] w-10 translate-x-1/2 text-border sm:block"
        strokeWidth={1}
        releaseThreshold={50}
      />
      <Contact locale={locale} />
    </div>
  </div>
</BaseLayout>