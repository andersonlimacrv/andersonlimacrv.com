---
import { defaultLocale, ui, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container-site flex flex-col items-center justify-between gap-3 py-8 sm:flex-row">
    <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
      © {year} Anderson Carvalho
    </p>
    <a
      href="#top"
      class="group-link transition-micro flex min-h-11 items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground hover:text-foreground"
    >
      {t.backToTop}
      <svg
        class="group-arrow transition-transform"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5" />
        <path d="m5 12 7-7 7 7" />
      </svg>
    </a>
  </div>
</footer>