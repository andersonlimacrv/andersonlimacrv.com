---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import KineticGrid from '../ui/KineticGrid.astro';
import TargetSimbol from '../ui/TargetSimbol.astro';
import { site, socialLinks } from '../../data/site';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
---

<SectionHeading
  number={site.sections.contact}
  title={t.sections.contact.title}
  id="contato"
  eyebrow={t.sections.contact.eyebrow}
>
  <Reveal>
    <div class="flex max-w-xl flex-col gap-4 p-6 sm:p-8">
      <p class="text-muted-foreground">
        {t.contactParagraph}
      </p>
      <KineticGrid class="h-60 border border-border" globalColor="default">
        <span
          class="pointer-events-none absolute bottom-3 left-4 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-muted-foreground"
        >
          {t.contactGridHint}
        </span>
        <TargetSimbol
          size={32}
          class="absolute bottom-3 right-4 opacity-60 transition-micro hover:opacity-100"
        />
      </KineticGrid>
      <a
        href={`mailto:${socialLinks.email}`}
        class="cursor-target transition-micro inline-flex min-h-11 w-fit items-center gap-2 font-mono text-sm uppercase tracking-[0.16em] text-foreground hover:text-primary"
      >
        {socialLinks.email}
      </a>
    </div>
  </Reveal>
</SectionHeading>