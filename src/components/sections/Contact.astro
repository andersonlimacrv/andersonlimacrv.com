---
import Reveal from '../ui/Reveal.astro';
import { TYPE } from '../ui/typography';
import SectionHeading from '../ui/SectionHeading.astro';
import TargetSimbol from '../ui/TargetSimbol.astro';
import { site, socialLinks } from '../../data/site';
import { getProfile } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const c = t.contact;
const profile = getProfile(locale);

// Exibição derivada da fonte única (site.ts). O botão COPIAR copia
// exatamente o texto exibido.
const whatsappDisplay = '+55 53 98100-4874';
const linkedinDisplay = 'in/andersonlimacrv';

const channels = [
  {
    label: c.channelLinkedin,
    display: linkedinDisplay,
    href: socialLinks.linkedin,
    external: true,
    simbol: false,
  },
  {
    label: c.channelWhatsapp,
    display: whatsappDisplay,
    href: socialLinks.whatsapp,
    external: true,
    simbol: false,
  },
  {
    label: c.channelEmail,
    display: socialLinks.email,
    href: `mailto:${socialLinks.email}`,
    external: false,
    simbol: true,
  },
  {
    label: c.channelLocation,
    display: profile.hero.location,
    href: undefined,
    external: false,
    simbol: false,
  },
] as const;

const fieldClass = `mt-2 w-full border border-input bg-transparent px-3 py-2.5 ${TYPE.body} text-foreground placeholder:text-muted-foreground/60 transition-micro`;
const errorClass = `${TYPE.body} mt-1.5 hidden text-destructive`;
---

<SectionHeading
  number={site.sections.contact}
  title={t.sections.contact.title}
  id="contato"
  eyebrow={t.sections.contact.eyebrow}
>
  <div
    id="contato-content"
    class="flex flex-col divide-y divide-border lg:flex-row lg:divide-x lg:divide-y-0"
  >
    <!-- COLUNA ESQUERDA — chamada + canais -->
    <Reveal class="flex min-w-0 flex-1 flex-col gap-6 py-6 sm:py-8 lg:basis-[50%] lg:pr-8">
      <h3 class={`${TYPE.titleH2} uppercase`}>{c.title}</h3>
      <p class={`${TYPE.body} max-w-xl text-muted-foreground`}>
        {c.description}
      </p>
      <ul class="flex flex-col divide-y divide-border border-y border-border">
        {channels.map((ch) => (
          <li class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 py-3">
            <span class={`${TYPE.label} text-muted-foreground/60`}>{ch.label}</span>
            {ch.href ? (
              <span class="flex min-w-0 items-center gap-3">
                <a
                  href={ch.href}
                  {...(ch.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class={`${TYPE.body} min-w-0 cursor-target break-words text-foreground transition-micro hover:underline hover:underline-offset-4`}
                >
                  {ch.display}
                </a>
                {ch.simbol && <TargetSimbol size={25} class="shrink-0" />}
              </span>
            ) : (
              <span class={`${TYPE.body} min-w-0 break-words text-foreground`}>
                {ch.display}
              </span>
            )}
            <button
              type="button"
              data-copy={ch.display}
              data-copy-label={c.copy}
              data-copied-label={c.copied}
              aria-live="polite"
              class={`${TYPE.label} min-h-11 cursor-target border border-border px-3 text-muted-foreground transition-micro hover:text-foreground`}
            >
              {c.copy}
            </button>
          </li>
        ))}
      </ul>
    </Reveal>

    <!-- COLUNA DIREITA — formulário -->
    <Reveal delay={80} class="flex min-w-0 flex-1 flex-col py-6 sm:py-8 lg:basis-[50%] lg:pl-8">
      <form
        id="contact-form"
        action={`mailto:${socialLinks.email}`}
        method="get"
        data-email={socialLinks.email}
        data-whatsapp={socialLinks.whatsapp}
        data-err-required={c.errRequired}
        data-err-email={c.errEmail}
        data-err-max={c.errMax}
        class="flex min-w-0 flex-col border border-border"
      >
        <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3 sm:px-6">
          <span class={`${TYPE.label} text-muted-foreground`}>{c.formHead}</span>
          <span
            id="contact-counter"
            data-max="1000"
            aria-live="polite"
            class={`${TYPE.label} text-muted-foreground`}
          >
            0/1000
          </span>
        </div>

        <div class="flex flex-col gap-5 p-4 sm:p-6">
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="min-w-0">
              <label for="contact-name" class={`${TYPE.label} text-muted-foreground`}>
                {c.nameLabel}
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength={100}
                placeholder={c.namePlaceholder}
                aria-describedby="contact-name-error"
                class={fieldClass}
              />
              <p id="contact-name-error" aria-live="polite" class={errorClass}></p>
            </div>
            <div class="min-w-0">
              <label for="contact-email" class={`${TYPE.label} text-muted-foreground`}>
                {c.emailLabel}
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength={254}
                placeholder={c.emailPlaceholder}
                aria-describedby="contact-email-error"
                class={fieldClass}
              />
              <p id="contact-email-error" aria-live="polite" class={errorClass}></p>
            </div>
          </div>

          <fieldset>
            <legend class={`${TYPE.label} text-muted-foreground`}>{c.subjectLabel}</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {c.subjects.map((subject, i) => (
                <label class="cursor-target">
                  <input
                    type="radio"
                    name="subject"
                    value={subject}
                    checked={i === 0}
                    class="peer sr-only"
                  />
                  <span
                    class={`inline-flex min-h-11 items-center border border-border px-3 py-2 ${TYPE.label} text-muted-foreground transition-micro hover:text-foreground peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-background`}
                  >
                    {subject}
                  </span>
                </label>
              ))}
            </div>
            <p id="contact-subject-error" aria-live="polite" class={errorClass}></p>
          </fieldset>

          <div class="min-w-0">
            <label for="contact-message" class={`${TYPE.label} text-muted-foreground`}>
              {c.messageLabel}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows={6}
              required
              maxlength={1000}
              placeholder={c.messagePlaceholder}
              aria-describedby="contact-message-error contact-counter"
              class={`${fieldClass} min-h-32 resize-y`}></textarea>
            <p id="contact-message-error" aria-live="polite" class={errorClass}></p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <button
              type="submit"
              class={`inline-flex min-h-11 flex-1 cursor-target items-center justify-center border border-primary bg-primary px-4 py-2.5 ${TYPE.label} text-primary-foreground transition-micro hover:opacity-90`}
            >
              {c.send}
            </button>
            <a
              id="contact-direct"
              href={socialLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex min-h-11 flex-1 cursor-target items-center justify-center border border-border px-4 py-2.5 ${TYPE.label} text-muted-foreground transition-micro hover:text-foreground`}
            >
              {c.direct}
            </a>
          </div>
        </div>
      </form>
    </Reveal>
  </div>
</SectionHeading>

<script>
  import './contact-form';
</script>
