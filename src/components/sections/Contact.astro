---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import TargetSimbol from '../ui/TargetSimbol.astro';
import { site, socialLinks } from '../../data/site';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
---

<SectionHeading
  number={site.sections.contact}
  title={t.sections.contact.title}
  id="contato"
  eyebrow={t.sections.contact.eyebrow}
>
  <Reveal>
    <div class="flex max-w-xl flex-col gap-4 p-6 sm:p-8">
      <p class="text-muted-foreground">
        {t.contactParagraph}
      </p>
    <div class="flex items-center cursor-target transition-micro group">
      <a
        href={`mailto:${socialLinks.email}`}
        class="font-mono text-sm uppercase tracking-[0.16em] text-foreground hover:text-primary"
      >
        {socialLinks.email}
      </a>
      <TargetSimbol
        size={32}
        class="mx-4 group-hover:opacity-100"
      />
    </div>

    </div>
  </Reveal>
</SectionHeading>