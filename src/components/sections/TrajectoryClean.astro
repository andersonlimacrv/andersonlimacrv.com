---
import type { Locale } from '../../i18n/ui';
import { TYPE } from '../ui/typography';
import { ui, defaultLocale } from '../../i18n/ui';
import { getTimeline } from '../../data/timeline';
import Sep from '../ui/Sep.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const timeline = getTimeline(locale);

type Row = {
  company: string;
  role: string;
  period: string;
  year: number;
};

function extractYear(period: string): number {
  const m = period.match(/\d{4}/);
  return m ? Number(m[0]) : 0;
}

function isEducationRole(role: string): boolean {
  const r = role.toLowerCase();
  return (
    r.includes('pós') ||
    r.includes('posgrado') ||
    r.includes('postgraduate') ||
    r.includes('cst') ||
    r.includes('curso técnico') ||
    r.includes('integrated technical')
  );
}

const workRows: Row[] = timeline.careerJourney
  .filter((e) => !isEducationRole(e.role))
  .map((e) => ({
    company: e.company,
    role: e.role,
    period: e.period,
    year: extractYear(e.period),
  }))
  .sort((a, b) => b.year - a.year);

const eduRows: Row[] = timeline.education
  .map((e) => ({
    company: e.institution,
    role: e.degree,
    period: e.period,
    year: extractYear(e.period),
  }))
  .sort((a, b) => b.year - a.year);

function formatPeriodShort(period: string): string {
  const years = period.match(/\d{4}/g) || [];
  const hasPresent = /presente|present/i.test(period);
  if (years.length === 0) return period;
  if (hasPresent) return `${years[0]} — ${period.match(/presente|present/i)?.[0] ?? 'present'}`;
  if (years.length === 1) return years[0];
  return `${years[0]} — ${years[years.length - 1]}`;
}
---

<div class="flex flex-col gap-8 sm:gap-10">
  <section aria-labelledby="trajectory-work-title">
    <h3 id="trajectory-work-title" class={`${TYPE.label} text-muted-foreground/60 mb-3`}>{t.aboutBadgeWork}</h3>
    <ul aria-label={t.aboutBadgeWork} class="flex flex-col">
      {
        workRows.map((row) => (
          <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 border-b border-border py-3.5 last:border-b-0 transition-micro hover:border-foreground/50">
            <span class="min-w-0 flex-1 truncate">
              <span class={`${TYPE.body} text-foreground`}>
                {row.role}
              </span>
              <Sep class="mx-1" />
              <span class={`${TYPE.body} text-muted-foreground/80`}>
                {row.company}
              </span>
            </span>
            <span
              class={`trajectory-period shrink-0 ${TYPE.label} text-muted-foreground whitespace-nowrap sm:text-right`}
              title={row.period}
            >
              {formatPeriodShort(row.period)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
  <section aria-labelledby="trajectory-edu-title">
    <h3 id="trajectory-edu-title" class={`${TYPE.label} text-muted-foreground/60 mb-3`}>{t.aboutBadgeEducation}</h3>
    <ul aria-label={t.aboutBadgeEducation} class="flex flex-col">
      {
        eduRows.map((row) => (
          <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 border-b border-border py-3.5 last:border-b-0 transition-micro hover:border-foreground/50">
            <span class="min-w-0 flex-1 truncate">
              <span class={`${TYPE.body} text-foreground`}>
                {row.role}
              </span>
              <Sep class="mx-2" />
              <span class={`${TYPE.body} text-muted-foreground/80`}>
                {row.company}
              </span>
            </span>
            <span
              class={`trajectory-period shrink-0 ${TYPE.label} text-muted-foreground whitespace-nowrap sm:text-right`}
              title={row.period}
            >
              {formatPeriodShort(row.period)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</div>
