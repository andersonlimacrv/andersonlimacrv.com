---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import BlueprintMorphEnd from '../blueprint/BlueprintMorphEnd.astro';
import portrait from '../../assets/me.png';
import { authorName, socialLinks } from '../../lib/site';
import { profile } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';
import CrossMark from '../ui/CrossMark.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];

const socials = [
  { label: 'GitHub', href: socialLinks.github, external: true },
  { label: 'LinkedIn', href: socialLinks.linkedin, external: true },
  { label: 'Instagram', href: socialLinks.instagram, external: true },
  { label: 'WhatsApp', href: socialLinks.whatsapp, external: true },
  { label: 'Email', href: `mailto:${socialLinks.email}`, external: false },
];

// Intervalo real da trajetória a partir dos períodos (min–max de anos).
// "presente" conta como o ano corrente.
const currentYear = new Date().getFullYear();
const years = profile.careerJourney.map((entry) => {
  const nums = (entry.period.match(/\d{4}/g) ?? []).map(Number);
  const start = nums[0];
  const end = entry.period.includes('presente') ? currentYear : (nums[nums.length - 1] ?? start);
  return { start, end };
});
const yearStart = Math.min(...years.map((y) => y.start));
const yearEnd = Math.max(...years.map((y) => y.end));
const yearRange = `${yearStart}—${yearEnd}`;

// Agrupa os itens da trajetória por ano de início.
// Mesmo ano → um único ponto fixo na linha (ex.: 2022).
const careerGroups = profile.careerJourney.reduce<{
  year: string;
  entries: typeof profile.careerJourney;
}[]>((acc, entry) => {
  const year = entry.period.match(/\d{4}/)?.[0] ?? '';
  const last = acc[acc.length - 1];
  if (last && last.year === year) {
    last.entries.push(entry);
  } else {
    acc.push({ year, entries: [entry] });
  }
  return acc;
}, []);
---

<SectionHeading
  number={t.sections.about.number}
  title={t.sections.about.title}
  id="sobre"
  eyebrow={t.sections.about.eyebrow}
>
  <div
    id="sobre-content"
    class="relative"
  >

    <!-- =========================================================
         ABOUT — duas colunas permanentes (desktop e mobile)
         01 — Perfil (retrato + informações ao lado)
         02 — Trajetória (timeline contínua)
         ========================================================= -->

    <div
      class="
        relative
        flex
        flex-col
        divide-y
        divide-border
        border-t
        border-border
        lg:flex-row
        lg:divide-x
        lg:divide-y-0
      "
    >

      <!-- =======================================================
           COLUNA 01 — PERFIL
           ======================================================= -->

      <section
        data-col="perfil"
        class="
          min-w-0
          basis-full
          pr-0
          lg:basis-[46%]
          lg:pr-10
        "
      >

        <!-- LABEL -->

        <div
          class="
            relative
            flex
            items-center
            justify-between
            border-b
            border-border
            py-4
          "
        >
          <p
            class="
              font-mono
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-muted-foreground
              sm:text-[10px]
            "
          >
            {t.aboutProfileColumn}
          </p>

          <span
            class="
              font-mono
              text-[8px]
              tracking-[0.15em]
              text-muted-foreground/50
              sm:text-[9px]
            "
          >
            01
          </span>
        </div>


        <!-- =====================================================
             FOTO + INFORMAÇÕES
             Sempre lado a lado (nunca abaixo da foto)
             ===================================================== -->

        <div
          class="
            flex
            items-start
            gap-3
            pt-3
          "
        >

          <!-- FOTO (alvo do morph) -->

          <div
            id="sobre-portrait"
            class="
              relative
              aspect-square
              min-w-0
              shrink-0
              basis-[47.5%]
              mt-5
            "
          >
            <BlueprintMorphEnd
              src={portrait}
              finalSize={160}
              finalX={0}
              finalY={0}
            />
            <p class="mt-40 lg:mt-46 px-3">Anderson Carvalho</p>
          </div>


          <!-- INFORMAÇÕES -->

          <div class="min-w-0 flex-1">
            <dl
              class="
                mt-1
                space-y-3
                sm:space-y-4
              "
            >

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutRoleTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    text-[9px]
                    font-medium
                    leading-snug
                    text-foreground
                    sm:text-xs
                  "
                >
                  {profile.hero.title.split(' · ').map((part) => (
                    <span class="block">{part}</span>
                  ))}
                </dd>
              </div>


              <!-- STACK PRINCIPAL -->

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutMainStackTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    font-mono
                    text-[8px]
                    leading-relaxed
                    text-muted-foreground
                    sm:text-[10px]
                  "
                >
                  {profile.hero.mainStack}
                </dd>
              </div>


              <!-- LOCALIZAÇÃO -->

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutLocationTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    font-mono
                    text-[8px]
                    leading-relaxed
                    text-muted-foreground
                    sm:text-[10px]
                  "
                >
                  {profile.hero.location}
                </dd>
              </div>

            </dl>
          </div>

        </div>


        <!-- =====================================================
             FRASE
             ===================================================== -->

        <Reveal
          class="
            border-t
            border-border
            py-4
            sm:py-5
          "
        >
          <div
            class="
              relative
              border
              border-dashed
              border-border
              px-4
              py-5
              sm:px-6
              sm:py-6
            "
          >

            <!-- blueprint corner -->

            <span
              aria-hidden="true"
              class="
                absolute
                -left-px
                -top-px
                h-3
                w-3
                border-l
                border-t
                border-foreground
              "
            ></span>

            <span
              aria-hidden="true"
              class="
                absolute
                -bottom-px
                -right-px
                h-3
                w-3
                border-b
                border-r
                border-foreground
              "
            ></span>


            <blockquote
              class="
                font-serif
                text-sm
                italic
                leading-relaxed
                tracking-tight
                text-foreground
                sm:text-lg
              "
            >
              <p>
                {t.aboutQuote}
              </p>

            </blockquote>

          </div>
        </Reveal>


        <!-- =====================================================
             SOBRE MIM
             ===================================================== -->

        <Reveal
          delay={60}
          class="
            border-t
            border-border
            py-4
            sm:py-5
          "
        >

          <div
            class="
              flex
              items-baseline
              justify-between
              gap-3
            "
          >
            <p
              class="
                font-mono
                text-[7px]
                uppercase
                tracking-[0.18em]
                text-muted-foreground/60
                sm:text-[9px]
              "
            >
              {t.aboutBioTitle}
            </p>

          </div>


          <div
            class="
              mt-4
              max-w-xl
              space-y-3
            "
          >
            {t.aboutBio.map((paragraph) => (
              <p
                class="
                  text-[10px]
                  leading-relaxed
                  text-muted-foreground
                  sm:text-xs
                "
              >
                {paragraph}
              </p>
            ))}
          </div>

        </Reveal>


        <!-- =====================================================
             SOCIAL / CONTATO — fim da coluna
             ===================================================== -->

        <Reveal
          delay={200}
          class="
            mt-6
            border-t
            border-border
            pt-6
          "
        >
          <footer
            class="
              flex
              flex-col
              gap-3
            "
          >
            <div class="flex flex-col gap-2">
              <p
                class="
                  font-mono
                  text-[7px]
                  uppercase
                  tracking-[0.18em]
                  text-muted-foreground/60
                  sm:text-[9px]
                "
              >
                {t.aboutContactTitle}
              </p>

              <nav
                class="flex flex-col"
                aria-label={t.aboutContactTitle}
              >
                {socials.map((social) => (
                  <a
                    href={social.href}
                    {...(social.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="
                      text-center
                      cursor-target
                      transition-micro
                      border
                      py-2.5
                      font-mono
                      text-xs
                      uppercase
                      tracking-[0.16em]
                      text-muted-foreground
                      hover:text-foreground
                      sm:text-sm
                    "
                  >
                    {social.label}
                  </a>
                ))}
              </nav>
            </div>
          </footer>
        </Reveal>

      </section>


      <!-- =======================================================
           COLUNA 02 — TRAJETÓRIA
           ======================================================= -->

      <section
        data-col="trajetoria"
        class="
          min-w-0
          basis-full
          pl-0
          lg:basis-[54%]
          lg:pl-10
        "
      >

        <!-- HEADER -->

        <div
          class="
            relative
            flex
            items-center
            justify-between
            border-b
            border-border
            py-4
          "
        >

          <p
            class="
              font-mono
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-muted-foreground
              sm:text-[10px]
            "
          >
            {t.aboutTrajectoryColumn}
          </p>

          <span
            class="
              font-mono
              text-[8px]
              tracking-[0.15em]
              text-muted-foreground/50
              sm:text-[9px]
            "
          >
            02
          </span>

        </div>


        <!-- =====================================================
             TIMELINE — linha contínua, anos como pontos fixos
             ===================================================== -->

        <div
          class="
            relative
            py-6
            sm:py-8
          "
        >

          <span
            class="
              absolute
              right-0
              top-2
              font-mono
              text-[8px]
              tracking-[0.15em]
              text-muted-foreground/40
              sm:text-[9px]
            "
          >
            {yearRange}
          </span>

          <!--
            Linha vertical contínua: percorre toda a trajetória
            (permanência). O ano de cada item é um ponto fixo nela.
          -->

          <span
            aria-hidden="true"
            class="
              absolute
              bottom-0
              left-[2.9rem]
              top-0
              w-px
              bg-border
              sm:left-[3.75rem]
            "
          ></span>

          <!-- T no topo: travessa horizontal sobre o topo da linha vertical -->

          <CrossMark
            variant="t-top"
            size={10}
            class="absolute left-[2.9rem] top-0 -translate-x-1/2 -translate-y-1/2 sm:left-[3.75rem]"
          />

          <!-- T no fim: travessa horizontal no fim da linha vertical -->

          <CrossMark
            variant="t-bottom"
            size={10}
            class="absolute left-[2.9rem] bottom-0 -translate-x-1/2 translate-y-1/2 sm:left-[3.75rem]"
          />


          <ol
            class="relative flex flex-col"
            aria-label={t.aboutTimelineLabel}
          >

            {careerGroups.map((group) => {

              const ongoing = group.entries.some((e) => e.period.includes('presente'));

              return (
                <li
                  class="
                    relative
                    flex
                    gap-3
                    pb-7
                    last:pb-0
                    sm:gap-5
                    sm:pb-8
                  "
                >

                  <!-- ANO (ponto fixo na linha) -->

                  <div class="relative w-[3.2rem] shrink-0 sm:w-[4.1rem]">
                    <p
                      class="
                        pt-0.5
                        pr-4
                        text-right
                        font-mono
                        text-[9px]
                        font-medium
                        tracking-[0.12em]
                        text-foreground
                        sm:pr-6
                        sm:text-xs
                      "
                    >
                      {group.year}
                    </p>

                    <!-- MARCADOR na linha: concluído = preenchido; em andamento = vazio -->

                    <span
                      aria-hidden="true"
                      class={`
                        absolute
                        left-[calc(2.9rem-0.3125rem)]
                        top-1
                        h-2.5
                        w-2.5
                        border
                        border-foreground
                        sm:left-[calc(3.75rem-0.3125rem)]
                        ${ongoing ? 'bg-background' : 'bg-foreground'}
                      `}
                    ></span>
                  </div>


                  <!-- EXPERIÊNCIA(S) DO ANO -->

                  <div
                    class="
                      relative
                      min-w-0
                      flex-1
                    "
                  >

                    {group.entries.map((entry) => (
                      <div
                        class="
                          border-b
                          border-border
                          pb-6
                          last:border-b-0
                          last:pb-0
                        "
                      >

                        <!-- PERÍODO (data ao lado do ano) -->

                        <p
                          class="
                            pt-0.5
                            font-mono
                            text-[7px]
                            uppercase
                            tracking-[0.13em]
                            text-muted-foreground/60
                            sm:text-[9px]
                          "
                        >
                          {entry.period}
                        </p>

                        <!-- CARGO / FORMAÇÃO -->

                        <h3
                          class="
                            mt-2
                            text-[10px]
                            font-semibold
                            leading-snug
                            tracking-[-0.01em]
                            text-foreground
                            sm:text-sm
                          "
                        >
                          {entry.role}
                        </h3>

                        <!-- EMPRESA -->

                        <p
                          class="
                            mt-1
                            text-[9px]
                            leading-relaxed
                            text-muted-foreground
                            sm:text-xs
                          "
                        >
                          {entry.company}
                        </p>

                        <!-- DESCRIÇÃO DE 1 LINHA -->

                        <p
                          class="
                            mt-2
                            text-[9px]
                            leading-relaxed
                            text-muted-foreground
                            sm:text-[11px]
                          "
                        >
                          {entry.summary}
                        </p>

                      </div>
                    ))}

                  </div>

                </li>
              );
            })}

          </ol>

        </div>

      </section>

    </div>

  </div>

</SectionHeading>