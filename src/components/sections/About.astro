---
import Reveal from '../ui/Reveal.astro';
import { TYPE } from '../ui/typography';
import SectionHeading from '../ui/SectionHeading.astro';
import BlueprintMorphEnd from '../blueprint/BlueprintMorphEnd.astro';
import TrajectoryClean from './TrajectoryClean.astro';
import Sep from '../ui/Sep.astro';
import portrait from '../../assets/me.png';
import { site, socialLinks } from '../../data/site';
import { profile } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];

const socials = [
  { label: 'GitHub', href: socialLinks.github, external: true },
  { label: 'LinkedIn', href: socialLinks.linkedin, external: true },
  { label: 'Instagram', href: socialLinks.instagram, external: true },
  { label: 'WhatsApp', href: socialLinks.whatsapp, external: true },
  { label: 'Email', href: `mailto:${socialLinks.email}`, external: false },
];
---

<SectionHeading
  number={site.sections.about}
  title={t.sections.about.title}
  id="sobre"
  eyebrow={t.sections.about.eyebrow}
>
  <div
    id="sobre-content"
    class="relative"
  >
    <div
      class="
        relative
        flex
        flex-col
        divide-y
        divide-border
        border-t
        border-border
      "
    >
      <section
        data-col="perfil"
        class="min-w-0 basis-full"
      >

        <!-- LABEL -->

        <div
          class="
            relative
            flex
            items-center
            justify-between
            border-b
            border-border
            py-6
            sm:py-8
          "
        >
          <span class={`${TYPE.label} text-muted-foreground`}>{t.aboutProfileColumn}</span>
          <span class={`${TYPE.label} text-muted-foreground/50`}>01</span>
        </div>

        <div
          class="
            flex
            items-start
            gap-3
            py-6
            sm:py-8
          "
        >

        <div
            id="sobre-portrait"
            class="
              relative
              aspect-square
              min-w-0
              shrink-0
              basis-[20%] md:basis-[30%]
              h-40
              mt-6 md:mt-6
              ml-14 md:ml-6 mr-4
            "
          >
            <BlueprintMorphEnd
              src={portrait}
              finalSize={160}
              finalX={0}
              finalY={0}
            />
          </div>


          <!-- INFORMAÇÕES -->

          <div class="min-w-0 flex-1">
            <dl
              class="
                mt-1
                space-y-3
                sm:space-y-4
              "
            >

              <div>
                <dt class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutRoleTitle}</dt>

                <dd
                  class="
                    mt-1
                   text-muted-foreground
                  "
                >
                  {profile.hero.title.split(' · ').map((part) => (
                    <span class="block">{part}</span>
                  ))}
                </dd>
              </div>


              <div>
                <dt class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutMainStackTitle}</dt>

                <dd
                  class="
                    mt-1
                    text-muted-foreground
                  "
                >
                  {profile.hero.mainStack.split(' · ').map((stack, i) => (
                    <>
                      {i > 0 && <Sep />}
                      {stack}
                    </>
                  ))}
                </dd>
              </div>

              <div>
                <dt class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutLocationTitle}</dt>

                <dd
                  class="
                    mt-1
                    text-muted-foreground
                  "
                >
                  {profile.hero.location}
                </dd>
              </div>

            </dl>
          </div>

        </div>

        <Reveal
          class="
            border-t
            border-border
            py-6
            sm:py-8
          "
        >
          <div
            class="
              relative
              border
              border-dashed
              border-border
              px-4
              py-5
              sm:px-6
              sm:py-6
            "
          >

            <span
              aria-hidden="true"
              class="
                absolute
                -left-px
                -top-px
                h-3
                w-3
                border-l
                border-t
                border-foreground
              "
            ></span>

            <span
              aria-hidden="true"
              class="
                absolute
                -bottom-px
                -right-px
                h-3
                w-3
                border-b
                border-r
                border-foreground
              "
            ></span>


            <blockquote
              class="
                text-foreground
              "
            >
              <p>
                {t.aboutQuote}
              </p>

            </blockquote>

          </div>
        </Reveal>


        <Reveal
          delay={60}
          class="
            border-t
            border-border
            py-6
            sm:py-8
          "
        >

          <div
            class="
              flex
              items-baseline
              justify-between
              gap-3
            "
          >
            <span class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutBioTitle}</span>
          </div>


          <div
            class="
              mt-4
              max-w-xl
              space-y-3
            "
          >
            {t.aboutBio.map((paragraph) => (
              <p
                class="
                  text-muted-foreground
                "
              >
                {paragraph}
              </p>
            ))}
          </div>

        </Reveal>

        <Reveal
          delay={200}
          class="
            border-t
            border-border
            py-6
            sm:py-8
          "
        >
          <footer
            class="
              flex
              flex-col
              gap-3
            "
          >
            <div class="flex flex-col gap-2">
              <span class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutContactTitle}</span>

              <nav
                class="flex flex-col"
                aria-label={t.aboutContactTitle}
              >
                {socials.map((social) => (
                  <a
                    href={social.href}
                    {...(social.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="
                      text-center
                      cursor-target
                      transition-micro
                      border
                      py-2.5
                      text-muted-foreground
                      hover:text-foreground
                    "
                  >
                    {social.label}
                  </a>
                ))}
              </nav>
            </div>
          </footer>
        </Reveal>

      </section>


      <!-- =======================================================
            BLOCO 02 — TRAJETÓRIA (sempre abaixo do Perfil)
            ======================================================= -->

      <section
        data-col="trajetoria"
        class="min-w-0 basis-full"
      >

        <!-- HEADER -->

        <div
          class="
            relative
            flex
            items-center
            justify-between
            border-b
            border-border
            py-6
            sm:py-8
          "
        >
          <span class={`${TYPE.label} text-muted-foreground`}>{t.aboutTrajectoryColumn}</span>
          <span class={`${TYPE.label} text-muted-foreground/50`}>02</span>
        </div>

        <div class="py-6 sm:py-8">
          <TrajectoryClean locale={locale} />
        </div>

      </section>

    </div>

  </div>

</SectionHeading>