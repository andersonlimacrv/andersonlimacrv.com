---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import BlueprintMorphEnd from '../blueprint/BlueprintMorphEnd.astro';
import portrait from '../../assets/me.png';
import { authorName, socialLinks } from '../../lib/site';
import { profile, getExperienceFor } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';
import TargetHover from '../ui/TargetHover.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];

const phone = `+55 ${profile.hero.contact.phone.slice(0, 2)} ${profile.hero.contact.phone.slice(2, 7)}-${profile.hero.contact.phone.slice(7)}`;

const groupLabels = {
  frontend: 'Frontend',
  backend: 'Backend',
  embeddedAndIot: 'Embedded & IoT',
} as const;

const groupKeys = ['frontend', 'backend', 'embeddedAndIot'] as const;

const socials = [
  { label: 'GitHub', href: socialLinks.github, external: true },
  { label: 'LinkedIn', href: socialLinks.linkedin, external: true },
  { label: 'Email', href: `mailto:${socialLinks.email}`, external: false },
];

const arrowSvg =
  '<svg class="group-arrow transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
---

<SectionHeading
  number={t.sections.about.number}
  title={t.sections.about.title}
  id="sobre"
  eyebrow={t.sections.about.eyebrow}
>
  <div id="sobre-content" class="relative flex flex-col lg:flex-row lg:flex-wrap lg:items-stretch">
    <BlueprintMorphEnd src={portrait} finalX={0.06} finalY={0} />

    <div class="flex min-w-0 flex-col pt-44 lg:w-[min(40vw,55%)] lg:shrink-0 lg:pt-0 lg:pl-44 lg:pr-12">
      <Reveal>
        <blockquote class="font-serif text-2xl italic leading-snug tracking-tight text-foreground sm:text-3xl">
          <p>{t.aboutQuote}</p>
          <cite class="mt-4 block font-mono text-xs not-italic uppercase tracking-[0.16em] text-muted-foreground">
            {authorName}
          </cite>
        </blockquote>
      </Reveal>

      <Reveal delay={60} class="mt-8 border-t border-border pt-8">
        <div class="space-y-4 text-lg leading-relaxed text-muted-foreground">
          {t.aboutBio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </Reveal>

      <Reveal delay={120} class="mt-8 border-t border-border pt-8">
        <div class="flex flex-col gap-4">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
            {t.aboutFactsTitle}
          </p>
          <dl class="flex flex-col">
            {profile.about.map((item) => (
              <div class="flex flex-col gap-1 border-t border-border py-3 first:border-t-0">
                <dt class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground/80">
                  {item.label}
                </dt>
                <dd class="text-sm leading-relaxed text-muted-foreground">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </Reveal>

      <Reveal delay={180} class="mt-8 border-t border-border pt-8">
        <footer class="flex flex-col gap-4">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
            {t.aboutContactTitle}
          </p>
          <p class="font-mono text-xs text-muted-foreground">{profile.hero.location}</p>
          <p class="font-mono text-xs text-muted-foreground">{phone}</p>
          <nav class="flex flex-col" aria-label={t.aboutContactTitle}>
            {socials.map((social) => (
              <a
                href={social.href}
                {...(social.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="group-link cursor-target transition-micro flex min-h-11 items-center gap-2 font-mono text-sm uppercase tracking-[0.16em] text-muted-foreground hover:text-foreground"
              >
                {social.label}
                <Fragment set:html={arrowSvg} />
              </a>
            ))}
          </nav>
        </footer>
      </Reveal>
    </div>

    <div class="flex min-w-0 flex-1 flex-col border-t border-border pt-10 lg:border-l lg:border-t-0 lg:pt-0 lg:pl-12">
      <Reveal>
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
          {t.aboutTimelineLabel}
        </p>
        <ol class="mt-2 flex flex-col" aria-label={t.aboutTimelineLabel}>
          {profile.careerJourney.map((entry) => {
            const exp = getExperienceFor(entry.company, entry.role);
            const highlights = exp?.highlights;
            return (
              <li class="border-t border-border py-6 first:border-t-0">
                <div class="flex flex-col gap-1.5">
                  <p class="font-sans text-lg font-semibold leading-snug tracking-[-0.01em] text-foreground">
                    {entry.role}
                  </p>
                  <p class="text-sm text-muted-foreground">{entry.company}</p>
                  <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
                    {entry.period}
                  </p>
                </div>
                {highlights && (
                  <details class="group mt-4">
                    <summary class="flex list-none cursor-pointer items-center justify-between gap-2 border border-border px-3 py-2 font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground transition-micro hover:text-foreground [&::-webkit-details-marker]:hidden">
                      {t.aboutDetailsLabel}
                      <span class="transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    {Array.isArray(highlights) ? (
                      <ul class="mt-4 flex flex-col gap-1.5 border-l border-border pl-4">
                        {highlights.map((h) => (
                          <li class="text-sm leading-relaxed text-muted-foreground">{h}</li>
                        ))}
                      </ul>
                    ) : (
                      <div class="mt-4 flex flex-col gap-4">
                        {groupKeys.map((key) => {
                          const items = highlights[key];
                          if (!items) return null;
                          return (
                            <div>
                              <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
                                {groupLabels[key]}
                              </p>
                              <ul class="mt-1.5 flex flex-col gap-1.5 border-l border-border pl-4">
                                {items.map((h) => (
                                  <li class="text-sm leading-relaxed text-muted-foreground">{h}</li>
                                ))}
                              </ul>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </details>
                )}
              </li>
            );
          })}
        </ol>
      </Reveal>
    </div>

    <Reveal delay={240} class="mt-8 w-full border-t border-border pt-8 lg:basis-full">
      <div class="flex flex-col gap-4">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
          {t.aboutStackTitle}
        </p>
        <div class="flex flex-col gap-x-8 gap-y-6 sm:flex-row sm:flex-wrap">
          {profile.techStack.map((group) => (
            <div class="min-w-0 w-full sm:w-1/2 lg:w-1/3">
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground/80">
                {group.label}
              </p>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                {group.items.map((tag) => (
                  <li class="border border-border px-2 py-0.5 font-mono text-[11px] uppercase tracking-[0.08em] text-muted-foreground">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </Reveal>
  </div>
  <TargetHover
    hoverDuration={0.2}
    parallaxOn={true}
    parallaxStrength={7}
    cornerSize={12}
    borderWidth={2}
    offset={8}
  />
</SectionHeading>
