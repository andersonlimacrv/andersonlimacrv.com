---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import BlueprintMorphEnd from '../blueprint/BlueprintMorphEnd.astro';
import portrait from '../../assets/me.png';
import { authorName, socialLinks } from '../../lib/site';
import { profile } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';
import TargetHover from '../ui/TargetHover.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];

const socials = [
  { label: 'GitHub', href: socialLinks.github, external: true },
  { label: 'LinkedIn', href: socialLinks.linkedin, external: true },
  { label: 'Email', href: `mailto:${socialLinks.email}`, external: false },
];

const phoneRaw = profile.hero.contact.phone; // '53981004874'
const phoneDisplay = `+55 ${phoneRaw.slice(0, 2)} ${phoneRaw.slice(2, 7)}-${phoneRaw.slice(7)}`;

// Intervalo real da trajetória a partir dos períodos (min–max de anos).
// "presente" conta como o ano corrente.
const currentYear = new Date().getFullYear();
const years = profile.careerJourney.map((entry) => {
  const nums = (entry.period.match(/\d{4}/g) ?? []).map(Number);
  const start = nums[0];
  const end = entry.period.includes('presente') ? currentYear : (nums[nums.length - 1] ?? start);
  return { start, end };
});
const yearStart = Math.min(...years.map((y) => y.start));
const yearEnd = Math.max(...years.map((y) => y.end));
const yearRange = `${yearStart}—${yearEnd}`;
---

<SectionHeading
  number={t.sections.about.number}
  title={t.sections.about.title}
  id="sobre"
  eyebrow={t.sections.about.eyebrow}
>
  <div
    id="sobre-content"
    class="relative"
  >

    <!-- =========================================================
         ABOUT — duas colunas permanentes (desktop e mobile)
         01 — Perfil (retrato + informações ao lado)
         02 — Trajetória (timeline contínua)
         ========================================================= -->

    <div
      class="
        grid
        grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]
        divide-x
        divide-border
        border-t
        border-border
      "
    >

      <!-- =======================================================
           COLUNA 01 — PERFIL
           ======================================================= -->

      <section
        class="
          min-w-0
          pr-3
          sm:pr-6
          lg:pr-10
        "
      >

        <!-- LABEL -->

        <div
          class="
            flex
            items-center
            justify-between
            border-b
            border-border
            py-4
          "
        >
          <p
            class="
              font-mono
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-muted-foreground
              sm:text-[10px]
            "
          >
            {t.aboutProfileColumn}
          </p>

          <span
            class="
              font-mono
              text-[8px]
              tracking-[0.15em]
              text-muted-foreground/50
              sm:text-[9px]
            "
          >
            01
          </span>
        </div>


        <!-- =====================================================
             FOTO + INFORMAÇÕES
             Sempre lado a lado (nunca abaixo da foto)
             ===================================================== -->

        <div
          class="
            grid
            grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]
            items-start
            gap-3
            py-4
            sm:gap-5
            sm:py-8
          "
        >

          <!-- FOTO (alvo do morph) -->

          <div
            id="sobre-portrait"
            class="
              relative
              aspect-square
              min-w-0
              mt-5
            "
          >
            <BlueprintMorphEnd
              src={portrait}
              finalSize={160}
              finalX={0}
              finalY={0}
            />
          </div>


          <!-- INFORMAÇÕES -->

          <div class="min-w-0">
            <dl
              class="
                mt-1
                space-y-3
                sm:space-y-4
              "
            >

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutRoleTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    text-[9px]
                    font-medium
                    leading-snug
                    text-foreground
                    sm:text-xs
                  "
                >
                  {profile.hero.title.split(' · ').map((part) => (
                    <span class="block">{part}</span>
                  ))}
                </dd>
              </div>


              <!-- STACK PRINCIPAL -->

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutMainStackTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    font-mono
                    text-[8px]
                    leading-relaxed
                    text-muted-foreground
                    sm:text-[10px]
                  "
                >
                  {profile.hero.mainStack}
                </dd>
              </div>


              <!-- LOCALIZAÇÃO -->

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutLocationTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    font-mono
                    text-[8px]
                    leading-relaxed
                    text-muted-foreground
                    sm:text-[10px]
                  "
                >
                  {profile.hero.location}
                </dd>
              </div>

            </dl>
          </div>

        </div>


        <!-- =====================================================
             FRASE
             ===================================================== -->

        <Reveal
          class="
            border-t
            border-border
            py-6
            sm:py-7
          "
        >
          <div
            class="
              relative
              border
              border-dashed
              border-border
              px-4
              py-5
              sm:px-6
              sm:py-6
            "
          >

            <!-- blueprint corner -->

            <span
              aria-hidden="true"
              class="
                absolute
                -left-px
                -top-px
                h-3
                w-3
                border-l
                border-t
                border-foreground
              "
            ></span>

            <span
              aria-hidden="true"
              class="
                absolute
                -bottom-px
                -right-px
                h-3
                w-3
                border-b
                border-r
                border-foreground
              "
            ></span>


            <blockquote
              class="
                font-serif
                text-sm
                italic
                leading-relaxed
                tracking-tight
                text-foreground
                sm:text-lg
              "
            >
              <p>
                {t.aboutQuote}
              </p>

            </blockquote>

          </div>
        </Reveal>


        <!-- =====================================================
             SOBRE MIM
             ===================================================== -->

        <Reveal
          delay={60}
          class="
            border-t
            border-border
            py-6
            sm:py-7
          "
        >

          <div
            class="
              flex
              items-baseline
              justify-between
              gap-3
            "
          >
            <p
              class="
                font-mono
                text-[9px]
                uppercase
                tracking-[0.18em]
                text-muted-foreground
                sm:text-[10px]
              "
            >
              {t.aboutBioTitle}
            </p>

            <span
              class="
                font-mono
                text-[8px]
                text-muted-foreground/40
              "
            >
              01/02
            </span>
          </div>


          <div
            class="
              mt-4
              max-w-xl
              space-y-3
            "
          >
            {t.aboutBio.map((paragraph) => (
              <p
                class="
                  text-[10px]
                  leading-relaxed
                  text-muted-foreground
                  sm:text-xs
                "
              >
                {paragraph}
              </p>
            ))}
          </div>

        </Reveal>


        <!-- =====================================================
             SOCIAL / CONTATO — fim da coluna
             ===================================================== -->

        <Reveal
          delay={200}
          class="
            mt-8
            border-t
            border-border
            pt-8
          "
        >
          <footer
            class="
              flex
              flex-col
              gap-6
              lg:flex-row
              lg:items-start
              lg:justify-between
            "
          >
            <div class="flex flex-col gap-2">
              <p
                class="
                  font-mono
                  text-xs
                  uppercase
                  tracking-[0.16em]
                  text-muted-foreground
                "
              >
                {t.aboutContactTitle}
              </p>

              <nav
                class="flex flex-col"
                aria-label={t.aboutContactTitle}
              >
                {socials.map((social) => (
                  <a
                    href={social.href}
                    {...(social.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="
                      group-link
                      cursor-target
                      transition-micro
                      flex
                      min-h-11
                      items-center
                      gap-2
                      font-mono
                      text-sm
                      uppercase
                      tracking-[0.16em]
                      text-muted-foreground
                      hover:text-foreground
                    "
                  >
                    {social.label}
                  </a>
                ))}
              </nav>
            </div>

            <div class="flex flex-col gap-1.5">
              <p class="font-mono text-xs text-muted-foreground">
                {phoneDisplay}
              </p>
              <p class="font-mono text-xs text-muted-foreground">
                {profile.hero.location}
              </p>
            </div>
          </footer>
        </Reveal>

      </section>


      <!-- =======================================================
           COLUNA 02 — TRAJETÓRIA
           ======================================================= -->

      <section
        class="
          min-w-0
          pl-3
          sm:pl-6
          lg:pl-10
        "
      >

        <!-- HEADER -->

        <div
          class="
            flex
            items-center
            justify-between
            border-b
            border-border
            py-4
          "
        >

          <p
            class="
              font-mono
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-muted-foreground
              sm:text-[10px]
            "
          >
            {t.aboutTrajectoryColumn}
          </p>

          <span
            class="
              font-mono
              text-[8px]
              tracking-[0.15em]
              text-muted-foreground/50
              sm:text-[9px]
            "
          >
            {yearRange}
          </span>

        </div>


        <!-- =====================================================
             TIMELINE — linha contínua, anos como pontos fixos
             ===================================================== -->

        <div
          class="
            relative
            py-6
            sm:py-8
          "
        >

          <!--
            Linha vertical contínua: percorre toda a trajetória
            (permanência). O ano de cada item é um ponto fixo nela.
          -->

          <span
            aria-hidden="true"
            class="
              absolute
              bottom-0
              left-[2.9rem]
              top-0
              w-px
              bg-border
              sm:left-[3.75rem]
            "
          ></span>


          <ol
            class="relative flex flex-col"
            aria-label={t.aboutTimelineLabel}
          >

            {profile.careerJourney.map((entry) => {

              const year = entry.period.match(/\d{4}/)?.[0] ?? '';
              const ongoing = entry.period.includes('presente');

              return (
                <li
                  class="
                    relative
                    grid
                    grid-cols-[3.2rem_minmax(0,1fr)]
                    gap-3
                    pb-7
                    last:pb-0
                    sm:grid-cols-[4.1rem_minmax(0,1fr)]
                    sm:gap-5
                    sm:pb-8
                  "
                >

                  <!-- ANO (ponto fixo na linha) -->

                  <div class="relative">
                    <p
                      class="
                        pt-0.5
                        pr-4
                        text-right
                        font-mono
                        text-[9px]
                        font-medium
                        tracking-[0.12em]
                        text-foreground
                        sm:pr-6
                        sm:text-xs
                      "
                    >
                      {year}
                    </p>

                    <!-- MARCADOR na linha: concluído = preenchido; em andamento = vazio -->

                    <span
                      aria-hidden="true"
                      class={`
                        absolute
                        left-[calc(2.9rem-0.3125rem)]
                        top-1
                        h-2.5
                        w-2.5
                        border
                        border-foreground
                        sm:left-[calc(3.75rem-0.3125rem)]
                        ${ongoing ? 'bg-background' : 'bg-foreground'}
                      `}
                    ></span>
                  </div>


                  <!-- EXPERIÊNCIA -->

                  <div
                    class="
                      relative
                      min-w-0
                      border-b
                      border-border
                      pb-6
                      last:border-b-0
                    "
                  >

                    <!-- CARGO / FORMAÇÃO -->

                    <h3
                      class="
                        text-[10px]
                        font-semibold
                        leading-snug
                        tracking-[-0.01em]
                        text-foreground
                        sm:text-sm
                      "
                    >
                      {entry.role}
                    </h3>


                    <!-- EMPRESA -->

                    <p
                      class="
                        mt-1
                        text-[9px]
                        leading-relaxed
                        text-muted-foreground
                        sm:text-xs
                      "
                    >
                      {entry.company}
                    </p>


                    <!-- PERÍODO -->

                    <p
                      class="
                        mt-2
                        font-mono
                        text-[7px]
                        uppercase
                        tracking-[0.13em]
                        text-muted-foreground/60
                        sm:text-[9px]
                      "
                    >
                      {entry.period}
                    </p>


                    <!-- DESCRIÇÃO DE 1 LINHA -->

                    <p
                      class="
                        mt-2
                        text-[9px]
                        leading-relaxed
                        text-muted-foreground
                        sm:text-[11px]
                      "
                    >
                      {entry.summary}
                    </p>

                  </div>

                </li>
              );
            })}

          </ol>

        </div>

      </section>

    </div>

  </div>


  <!-- ===========================================================
       TARGET HOVER
       =========================================================== -->

  <TargetHover
    hoverDuration={0.2}
    parallaxOn={true}
    parallaxStrength={7}
    cornerSize={12}
    borderWidth={2}
    offset={8}
  />

</SectionHeading>