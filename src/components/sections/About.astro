---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import BlueprintMorphEnd from '../blueprint/BlueprintMorphEnd.astro';
import TrajectoryClean from './TrajectoryClean.astro';
import portrait from '../../assets/me.png';
import { site, socialLinks } from '../../data/site';
import { profile } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];

const socials = [
  { label: 'GitHub', href: socialLinks.github, external: true },
  { label: 'LinkedIn', href: socialLinks.linkedin, external: true },
  { label: 'Instagram', href: socialLinks.instagram, external: true },
  { label: 'WhatsApp', href: socialLinks.whatsapp, external: true },
  { label: 'Email', href: `mailto:${socialLinks.email}`, external: false },
];
---

<SectionHeading
  number={site.sections.about}
  title={t.sections.about.title}
  id="sobre"
  eyebrow={t.sections.about.eyebrow}
>
  <div
    id="sobre-content"
    class="relative"
  >

    <!-- =========================================================
          ABOUT — coluna única: Perfil acima, Trajetória abaixo
          01 — Perfil (retrato + informações ao lado)
          02 — Trajetória (lista clean com badges)
          ========================================================= -->

    <div
      class="
        relative
        flex
        flex-col
        divide-y
        divide-border
        border-t
        border-border
      "
    >

      <!-- =======================================================
            BLOCO 01 — PERFIL
            ======================================================= -->

      <section
        data-col="perfil"
        class="min-w-0 basis-full"
      >

        <!-- LABEL -->

        <div
          class="
            relative
            flex
            items-center
            justify-between
            border-b
            border-border
            py-4
          "
        >
          <p
            class="
              font-mono
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-muted-foreground
              sm:text-[10px]
            "
          >
            {t.aboutProfileColumn}
          </p>

          <span
            class="
              font-mono
              text-[8px]
              tracking-[0.15em]
              text-muted-foreground/50
              sm:text-[9px]
            "
          >
            01
          </span>
        </div>


        <!-- =====================================================
             FOTO + INFORMAÇÕES
             Sempre lado a lado (nunca abaixo da foto)
             ===================================================== -->

        <div
          class="
            flex
            items-start
            gap-3
            py-6
            sm:py-8
          "
        >

          <!-- FOTO (alvo do morph) -->

          <div
            id="sobre-portrait"
            class="
              relative
              aspect-square
              min-w-0
              shrink-0
              basis-[47.5%]
              mt-5
            "
          >
            <BlueprintMorphEnd
              src={portrait}
              finalSize={160}
              finalX={0}
              finalY={0}
            />
            <p class="mt-40 lg:mt-46 px-3">{site.name}</p>
          </div>


          <!-- INFORMAÇÕES -->

          <div class="min-w-0 flex-1">
            <dl
              class="
                mt-1
                space-y-3
                sm:space-y-4
              "
            >

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutRoleTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    text-[9px]
                    font-medium
                    leading-snug
                    text-foreground
                    sm:text-xs
                  "
                >
                  {profile.hero.title.split(' · ').map((part) => (
                    <span class="block">{part}</span>
                  ))}
                </dd>
              </div>


              <!-- STACK PRINCIPAL -->

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutMainStackTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    font-mono
                    text-[8px]
                    leading-relaxed
                    text-muted-foreground
                    sm:text-[10px]
                  "
                >
                  {profile.hero.mainStack}
                </dd>
              </div>


              <!-- LOCALIZAÇÃO -->

              <div>
                <dt
                  class="
                    font-mono
                    text-[7px]
                    uppercase
                    tracking-[0.18em]
                    text-muted-foreground/60
                    sm:text-[9px]
                  "
                >
                  {t.aboutLocationTitle}
                </dt>

                <dd
                  class="
                    mt-1
                    font-mono
                    text-[8px]
                    leading-relaxed
                    text-muted-foreground
                    sm:text-[10px]
                  "
                >
                  {profile.hero.location}
                </dd>
              </div>

            </dl>
          </div>

        </div>


        <!-- =====================================================
             FRASE
             ===================================================== -->

        <Reveal
          class="
            border-t
            border-border
            py-6
            sm:py-8
          "
        >
          <div
            class="
              relative
              border
              border-dashed
              border-border
              px-4
              py-5
              sm:px-6
              sm:py-6
            "
          >

            <!-- blueprint corner -->

            <span
              aria-hidden="true"
              class="
                absolute
                -left-px
                -top-px
                h-3
                w-3
                border-l
                border-t
                border-foreground
              "
            ></span>

            <span
              aria-hidden="true"
              class="
                absolute
                -bottom-px
                -right-px
                h-3
                w-3
                border-b
                border-r
                border-foreground
              "
            ></span>


            <blockquote
              class="
                font-serif
                text-sm
                italic
                leading-relaxed
                tracking-tight
                text-foreground
                sm:text-lg
              "
            >
              <p>
                {t.aboutQuote}
              </p>

            </blockquote>

          </div>
        </Reveal>


        <!-- =====================================================
             SOBRE MIM
             ===================================================== -->

        <Reveal
          delay={60}
          class="
            border-t
            border-border
            py-6
            sm:py-8
          "
        >

          <div
            class="
              flex
              items-baseline
              justify-between
              gap-3
            "
          >
            <p
              class="
                font-mono
                text-[7px]
                uppercase
                tracking-[0.18em]
                text-muted-foreground/60
                sm:text-[9px]
              "
            >
              {t.aboutBioTitle}
            </p>

          </div>


          <div
            class="
              mt-4
              max-w-xl
              space-y-3
            "
          >
            {t.aboutBio.map((paragraph) => (
              <p
                class="
                  text-[10px]
                  leading-relaxed
                  text-muted-foreground
                  sm:text-xs
                "
              >
                {paragraph}
              </p>
            ))}
          </div>

        </Reveal>


        <!-- =====================================================
             SOCIAL / CONTATO — fim da coluna
             ===================================================== -->

        <Reveal
          delay={200}
          class="
            border-t
            border-border
            py-6
            sm:py-8
          "
        >
          <footer
            class="
              flex
              flex-col
              gap-3
            "
          >
            <div class="flex flex-col gap-2">
              <p
                class="
                  font-mono
                  text-[7px]
                  uppercase
                  tracking-[0.18em]
                  text-muted-foreground/60
                  sm:text-[9px]
                "
              >
                {t.aboutContactTitle}
              </p>

              <nav
                class="flex flex-col"
                aria-label={t.aboutContactTitle}
              >
                {socials.map((social) => (
                  <a
                    href={social.href}
                    {...(social.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="
                      text-center
                      cursor-target
                      transition-micro
                      border
                      py-2.5
                      font-mono
                      text-xs
                      uppercase
                      tracking-[0.16em]
                      text-muted-foreground
                      hover:text-foreground
                      sm:text-sm
                    "
                  >
                    {social.label}
                  </a>
                ))}
              </nav>
            </div>
          </footer>
        </Reveal>

      </section>


      <!-- =======================================================
            BLOCO 02 — TRAJETÓRIA (sempre abaixo do Perfil)
            ======================================================= -->

      <section
        data-col="trajetoria"
        class="min-w-0 basis-full"
      >

        <!-- HEADER -->

        <div
          class="
            relative
            flex
            items-center
            justify-between
            border-b
            border-border
            py-4
          "
        >

          <p
            class="
              font-mono
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-muted-foreground
              sm:text-[10px]
            "
          >
            {t.aboutTrajectoryColumn}
          </p>

          <span
            class="
              font-mono
              text-[8px]
              tracking-[0.15em]
              text-muted-foreground/50
              sm:text-[9px]
            "
          >
            02
          </span>

        </div>


        <div class="py-6 sm:py-8">
          <TrajectoryClean locale={locale} />
        </div>

      </section>

    </div>

  </div>

</SectionHeading>