---
import Reveal from '../ui/Reveal.astro';
import { TYPE } from '../ui/typography';
import SectionHeading from '../ui/SectionHeading.astro';
import BlueprintMorphEnd from '../blueprint/BlueprintMorphEnd.astro';
import TrajectoryClean from './TrajectoryClean.astro';
import Sep from '../ui/Sep.astro';
import portrait from '../../assets/me.png';
import { site, socialLinks } from '../../data/site';
import { profile } from '../../data/profile';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';
import TargetSimbol from '../ui/TargetSimbol.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];

const socials = [
  { label: 'GitHub', href: socialLinks.github, external: true },
  { label: 'LinkedIn', href: socialLinks.linkedin, external: true },
  { label: 'Instagram', href: socialLinks.instagram, external: true },
  { label: 'WhatsApp', href: socialLinks.whatsapp, external: true },
  { label: 'Email', href: `mailto:${socialLinks.email}`, external: false },
];
---

<SectionHeading
  number={site.sections.about}
  title={t.sections.about.title}
  id="sobre"
  eyebrow={t.sections.about.eyebrow}
>
  <div id="sobre-content" class="relative">
    <header
      class="
        flex
        items-center
        gap-2
        border-b
        border-border
        py-6
        sm:py-8
      "
    >
      <span class={`${TYPE.label} text-muted-foreground/50`}>01</span>
      <span class={`${TYPE.label} text-muted-foreground`}>{t.aboutProfileColumn}</span>
    </header>

    <div
      class="
        flex
        flex-col
        divide-y
        divide-border
        lg:flex-row
        lg:divide-y-0
        lg:divide-x
      "
    >
      <!-- COLUNA 01 — PERFIL VISUAL -->
      <section
        data-col="perfil"
        class="flex min-w-0 flex-[0_0_100%] flex-col gap-6 py-6 sm:py-8 lg:basis-[50%] lg:pr-8"
      >
        <div class="flex flex-row gap-4">
          <div
            id="sobre-portrait"
            class="
              relative
              aspect-square
              h-30
              w-30
              shrink-0
              m-5
              flex-[0_0_120px]
              self-start
              lg:h-40
              lg:w-40
              lg:flex-[0_0_160px]
            "
          >
            <BlueprintMorphEnd
              src={portrait}
              finalSize={160}
              finalX={0}
              finalY={0}
            />
          </div>

          <Reveal class="min-w-0 flex-1">
            <div
              class="
                relative
                border
                border-dashed
                border-border
                px-4
                py-5
                sm:px-6
                sm:py-6
              "
            >
              <span
                aria-hidden="true"
                class="
                  absolute
                  -left-px
                  -top-px
                  h-3
                  w-3
                  border-l
                  border-t
                  border-foreground
                "
              ></span>

              <span
                aria-hidden="true"
                class="
                  absolute
                  -bottom-px
                  -right-px
                  h-3
                  w-3
                  border-b
                  border-r
                  border-foreground
                "
              ></span>

              <blockquote class={`${TYPE.quote} text-foreground`}>
                <p>{t.aboutQuote}</p>
              </blockquote>
            </div>
          </Reveal>
        </div>

        <Reveal delay={60}>
          <footer class="flex flex-col gap-3">
            <span class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutContactTitle}</span>

            <nav class="flex flex-col" aria-label={t.aboutContactTitle}>
              {socials.map((social) => (
                <a
                  href={social.href}
                  {...(social.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                  class={`
                    ${TYPE.label}
                    text-center
                    cursor-target
                    transition-micro
                    border
                    py-2.5
                    text-muted-foreground
                    hover:text-foreground
                  `}
                >
                  {social.label}
                </a>
              ))}
            </nav>
          </footer>
        </Reveal>
      </section>

      <!-- COLUNA 02 — DADOS (padrão título → conteúdo, 3 tipos) -->
      <section data-col="dados" class="flex min-w-0 flex-1 flex-col lg:basis-[50%] lg:pl-8">
        <div class="flex flex-col">
          <div class="py-2">
            <span class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutRoleTitle}</span>
            <p class={`${TYPE.body} mt-2 text-muted-foreground`}>
              {profile.hero.title.split(' · ').map((part) => (
                <span class="block"> <TargetSimbol size={16} class="inline-block align-middle mr-2" />{part}</span>
              ))}
            </p>
          </div>

         <div class="py-2">
            <span class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutMainStackTitle}</span>
            <p class={`${TYPE.body} mt-2 text-muted-foreground`}>
              {profile.hero.mainStack.split(' · ').map((stack, i) => (
                <>
                  {i > 0 && <Sep />}
                  {stack}
                </>
              ))}
            </p>
          </div>

          <div class="py-2">
            <span class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutLocationTitle}</span>
            <p class={`${TYPE.body} mt-2 text-muted-foreground`}>
              {profile.hero.location}
            </p>
          </div>

         <div class="py-2">
            <span class={`${TYPE.label} text-muted-foreground/60`}>{t.aboutBioTitle}</span>
            <div class="mt-2 space-y-3">
              {t.aboutBio.map((paragraph) => (
                <p class={`${TYPE.body} text-muted-foreground`}>
                  {paragraph}
                </p>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- TRAJETÓRIA — abaixo das duas colunas, largura total -->
    <section data-col="trajetoria" class="min-w-0 border-t border-border">
      <header
        class="
        mt-8
          flex
          items-center
          gap-2
          py-6
          sm:py-8
        "
      >
        <span class={`${TYPE.label} text-muted-foreground/50`}>02</span>
        <span class={`${TYPE.label} text-muted-foreground`}>{t.aboutTrajectoryColumn}</span>
      </header>

      <div class="py-6 sm:py-8">
        <TrajectoryClean locale={locale} />
      </div>
    </section>

  </div>

</SectionHeading>
