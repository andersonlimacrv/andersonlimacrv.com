---
import Eyebrow from '../ui/Eyebrow.astro';
import { TYPE } from '../ui/typography';
import ScrollMorphPortrait from '../ui/ScrollMorphPortrait.astro';
import BlueprintMorphStart from '../blueprint/BlueprintMorphStart.astro';
import BlueprintMorphBoard from '../blueprint/BlueprintMorphBoard.astro';
import portrait from '../../assets/me.png';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const baseUrl = locale === defaultLocale ? '' : `/${locale}`;
---

<section id="hero" aria-labelledby="hero-title" class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8 pt-8 pb-12 sm:pt-12 sm:pb-16 md:pt-16 flex flex-col gap-10 md:flex-row md:items-center md:justify-between md:gap-16">
  <div class="max-w-2xl md:flex-1 md:min-w-0">
    <p class="mb-6">
      <Eyebrow label={t.heroEyebrow} label2={site.heroEyebrowYear} />
    </p>
    <h1 id="hero-title" class={`hero-name ${TYPE.hero}`}>
      {(t as any).heroTitle ?? site.name} 
    </h1>
    <p class={`mt-6 max-w-md ${TYPE.quote} not-italic text-muted-foreground`}>
      {t.heroSubtitle}
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={`${baseUrl}/#projetos`}
        class={`inline-flex min-h-11 w-full cursor-target cursor-target-filled items-center justify-center border border-primary bg-primary px-4 py-2.5 sm:w-auto ${TYPE.label} text-primary-foreground transition-micro hover:opacity-90`}
      >
        {t.heroCtaProjects}
      </a>
      <a
        href={`${baseUrl}/#contato`}
        class={`inline-flex min-h-11 w-full cursor-target items-center justify-center border border-border px-4 py-2.5 sm:w-auto ${TYPE.label} text-muted-foreground transition-micro hover:text-foreground`}
      >
        {t.heroCtaContact}
      </a>
    </div>
  </div>

  <div class="relative shrink-0 w-full md:w-[min(648px,50%)]">
    <BlueprintMorphBoard locale={locale} finalSize={160} finalX={0} finalY={0} />
    <ScrollMorphPortrait
      src={portrait}
      alt={`${t.portraitAlt} ${site.name}`}
      caption={t.figCaption}
      target="#sobre-portrait"
      finalSize={160}
      finalX={0}
      finalY={0}
    />
    <BlueprintMorphStart finalSize={160} />
  </div>
</section>