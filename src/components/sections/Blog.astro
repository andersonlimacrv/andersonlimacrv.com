---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import PostCard from '../ui/PostCard.astro';
import TargetSimbol from '../ui/TargetSimbol.astro';
import { TYPE } from '../ui/typography';
import { getPublishedPosts } from '../../lib/posts';
import { site } from '../../data/site';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const posts = await getPublishedPosts(locale);
const baseUrl = locale === defaultLocale ? '' : `/${locale}`;
---

<SectionHeading
  number={site.sections.blog}
  title={t.sections.blog.title}
  id="blog"
  eyebrow={t.sections.blog.eyebrow}
>
  <Reveal>
    {posts.length > 0 ? (
      <div class="flex flex-col divide-y divide-border">
        {posts.slice(0, 3).map((post) => (
          <PostCard post={post} locale={locale} />
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground">
        {t.blogComingSoon}
      </p>
    )}
  </Reveal>
  <div class="mt-8">
    <a
      href={`${baseUrl}/blog`}
      class={`cursor-target transition-micro group inline-flex min-h-11 items-center gap-2 ${TYPE.label} text-muted-foreground hover:text-foreground`}
    >
      {t.viewAllPosts}
        <TargetSimbol size={25} class="md:hidden" />
    </a>
  </div>
</SectionHeading>
