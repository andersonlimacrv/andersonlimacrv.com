---
import Reveal from '../ui/Reveal.astro';
import PostCard from '../ui/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const posts = await getPublishedPosts(locale);
const baseUrl = locale === defaultLocale ? '' : `/${locale}`;
---

<section id="blog" aria-labelledby="blog-title" class="scroll-mt-24 py-16 sm:py-20">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <h2 id="blog-title" class="font-sans text-h1 font-bold leading-[1.1] tracking-tight">
        {t.sections.blog.eyebrow}
      </h2>
      <a
        href={`${baseUrl}/blog`}
        class="cursor-target transition-micro group inline-flex min-h-11 items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground hover:text-foreground"
      >
        {t.viewAllPosts}
        <span aria-hidden="true" class="transition-micro inline-block group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
    <Reveal>
      <div class="mt-8">
        {posts.length > 0 ? (
          <div class="flex flex-col divide-y divide-border">
            {posts.slice(0, 3).map((post) => (
              <PostCard post={post} locale={locale} />
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground">
            {t.blogComingSoon}
          </p>
        )}
      </div>
    </Reveal>
  </div>
</section>
