---
import { getImage } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import FlowingMenu from '../ui/FlowingMenu.astro';
import { TYPE } from '../ui/typography';
import portrait from '../../assets/me.png';
import { getProjects } from '../../data/projects';
import { site } from '../../data/site';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const projects = getProjects(locale);

const thumb169 = await getImage({
  src: portrait,
  format: 'webp',
  width: 448,
  height: 252,
  fit: 'cover',
});
---

<SectionHeading
  number={site.sections.projects}
  title={t.sections.projects.title}
  id="projetos"
  eyebrow={t.sections.projects.eyebrow}
>
  <p class={`max-w-2xl pt-6 ${TYPE.label} text-muted-foreground`} data-reveal>{t.sections.projects.subtitle}</p>
  <div class="mt-8">
    <FlowingMenu
      navLabel={t.sections.projects.title}
      variant="full"
      id="projects-flowing"
      images={[{ src: thumb169.src, w: 224, h: 126 }]}
      items={projects.map((project) => ({
        href: project.url,
        label: project.title,
        description: project.description,
        tags: project.tags,
        external: true,
      }      ))}
    />
  </div>
</SectionHeading>