---
import Reveal from '../ui/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectLink from '../ui/ProjectLink.astro';
import { getProjects } from '../../data/projects';
import { site } from '../../data/site';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const projects = getProjects(locale);
---

<SectionHeading
  number={site.sections.projects}
  title={t.sections.projects.title}
  id="projetos"
  eyebrow={t.sections.projects.eyebrow}
>
  <Reveal>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectLink {...project} />
      ))}
    </div>
  </Reveal>
</SectionHeading>