---
import { TYPE } from '../ui/typography';
import { defaultLocale, ui, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';
import TargetSimbol from '../ui/TargetSimbol.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = ui[locale];
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background/80">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8 flex flex-col items-center justify-between gap-3 py-8 sm:flex-row">
      <a
      href="#top"
      class={`cursor-target group transition-micro flex min-h-11 items-center gap-2 ${TYPE.label} text-muted-foreground hover:text-foreground`}
      >
      {t.backToTop}
      <TargetSimbol size={25} class="md:hidden" />
    </a>
    <p class={`${TYPE.label} text-muted-foreground`}>
      © {year} {site.name}
    </p>
  </div>
</footer>