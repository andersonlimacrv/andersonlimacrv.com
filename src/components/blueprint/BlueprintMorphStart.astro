---
interface Props {
  finalSize?: number;
}

const { finalSize = 160 } = Astro.props;
const radius = finalSize / 2;
---

<div class="bp-wireframe bp-start" data-bp-wireframe aria-hidden="true" style={`--bp-final-size: ${finalSize}px`}>
  <div class="bp-rect">
    <svg class="bp-corners" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="bp-corner" d="M 2 7 V 2 H 7" />
      <path class="bp-corner" d="M 93 2 H 98 V 7" />
      <path class="bp-corner" d="M 98 93 V 98 H 93" />
      <path class="bp-corner" d="M 7 98 H 2 V 93" />
    </svg>

    <div class="bp-ghost">
      <span class="bp-ghost-cross bp-ghost-cross-x" aria-hidden="true"></span>
      <span class="bp-ghost-cross bp-ghost-cross-y" aria-hidden="true"></span>
      <span class="bp-ghost-tick bp-ghost-tick-top" aria-hidden="true"></span>
      <span class="bp-ghost-tick bp-ghost-tick-bottom" aria-hidden="true"></span>
      <span class="bp-ghost-tick bp-ghost-tick-right" aria-hidden="true"></span>
      <b class="bp-ghost-r-label" aria-hidden="true">r {radius}px</b>
      <b class="bp-ghost-q bp-ghost-q-a" data-bp="a" data-bp-live aria-hidden="true">—</b>
      <b class="bp-ghost-q bp-ghost-q-s" data-bp="s" data-bp-live aria-hidden="true">—</b>
      <b class="bp-ghost-q bp-ghost-q-xy" data-bp="xy" data-bp-live aria-hidden="true">0 · 0</b>
    </div>

    <span class="bp-ghost-r" aria-hidden="true">
      <span class="bp-ghost-r-line"></span>
    </span>
  </div>
</div>

<style>
  .bp-wireframe {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    color: var(--muted-foreground);
    /* Contraste ≥3:1 sobre o fundo (WCAG 1.4.11 — elementos não-texto). */
    --bp-line: color-mix(in oklab, var(--foreground) 48%, transparent);
    --bp-line-strong: color-mix(in oklab, var(--foreground) 60%, transparent);
  }

  .bp-rect {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--bp-h);
    aspect-ratio: 1122 / 1402;
    /* Sem borda contínua nem grade — só as cantoneiras marcam o enquadramento. */
  }

  /* Cantoneiras nos 4 cantos exatos do box da imagem */
  .bp-corners {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .bp-corner {
    fill: none;
    stroke: var(--bp-line);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  /* Círculo final (estado END) como fantasma tracejado sobre o retângulo */
  .bp-ghost {
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    width: var(--bp-final-size, 160px);
    height: var(--bp-final-size, 160px);
    translate: -50% 0;
    border: 1px dashed var(--bp-line-strong);
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--foreground) 4%, transparent);
  }

  .bp-ghost-cross {
    position: absolute;
    background-color: var(--bp-line);
  }

  .bp-ghost-cross-x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .bp-ghost-cross-y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  /* Traços de cota nos 4 pontos cardeais do círculo-fantasma (extensão do
     círculo): esquerda, superior, inferior e direita. Mesmo estilo/tamanho
     do traço do r (1rem horizontal). O rótulo r 80px fica no centro do
     círculo. */
  .bp-ghost-tick {
    position: absolute;
    width: 1rem;
    height: 0;
    border-top: 1px solid var(--bp-line-strong);
  }

  .bp-ghost-tick-top {
    left: 50%;
    top: -1rem;
    translate: -50% 0;
    rotate: 90deg;
  }

  .bp-ghost-tick-bottom {
    left: 50%;
    bottom: -1rem;
    translate: -50% 0;
    rotate: 90deg;
  }

  .bp-ghost-tick-right {
    top: 50%;
    right: -1.5rem;
    translate: 0 -50%;
  }

  /* Linha de cota do raio à esquerda do círculo-fantasma, na altura do centro */
  .bp-ghost-r {
    position: absolute;
    left: calc(50% - var(--bp-final-size, 160px) / 2 - 1.5rem);
    bottom: calc(0.5rem + var(--bp-final-size, 160px) / 2);
    translate: 0 50%;
  }

  .bp-ghost-r-line {
    display: block;
    width: 1rem;
    height: 0;
    border-top: 1px solid var(--bp-line-strong);
  }

  /* Rótulos de cota nos quadrantes do círculo-fantasma, fora do cruzamento
     das linhas-guia (crosshair). Orientação: os da esquerda colados à direita
     (text-align: right) e os da direita colados à esquerda (text-align: left),
     de modo que o conteúdo fique simétrico em torno do centro. */
  .bp-ghost-r-label,
  .bp-ghost-q {
    position: absolute;
    translate: 0 -50%;
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--foreground);
    white-space: nowrap;
  }

  .bp-ghost-r-label {
    right: calc(50% + 0.75rem);
    top: 59%;
    text-align: right;
  }

  .bp-ghost-q-a {
    right: calc(50% + 0.5rem);
    top: 41%;
    text-align: right;
    font-size: 0.5625rem;
  }

  .bp-ghost-q-s,
  .bp-ghost-q-xy {
    left: calc(50% + 0.75rem);
    text-align: left;
  }

  .bp-ghost-q-s {
    top: 41%;
  }

  .bp-ghost-q-xy {
    top: 59%;
    font-size: 0.5625rem;
    line-height: 1.2;
    white-space: pre-line;
  }
</style>

<script>
  import './morph-measure';
</script>