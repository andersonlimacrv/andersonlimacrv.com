---
import { TYPE } from '../ui/typography';

interface Props {
  finalSize?: number;
}

const { finalSize = 160 } = Astro.props;
---

<div class="bp-wireframe bp-start" data-bp-wireframe aria-hidden="true" style={`--bp-final-size: var(--morph-final-size, ${finalSize}px)`}>
  <div class="bp-rect">
    <svg class="bp-corners" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="bp-corner" d="M 2 7 V 2 H 7" />
      <path class="bp-corner" d="M 93 2 H 98 V 7" />
      <path class="bp-corner" d="M 98 93 V 98 H 93" />
      <path class="bp-corner" d="M 7 98 H 2 V 93" />
    </svg>

    <div class="bp-ghost">
      <span class="bp-ghost-cross bp-ghost-cross-x" aria-hidden="true"></span>
      <span class="bp-ghost-cross bp-ghost-cross-y" aria-hidden="true"></span>
      <span class="bp-ghost-tick bp-ghost-tick-top" aria-hidden="true"></span>
      <span class="bp-ghost-tick bp-ghost-tick-bottom" aria-hidden="true"></span>
      <span class="bp-ghost-tick bp-ghost-tick-right" aria-hidden="true"></span>
      <b class={`bp-ghost-r-label ${TYPE.ghostLabel}`} data-bp="rlabel" aria-hidden="true">r —</b>
      <b class={`bp-ghost-q bp-ghost-q-a ${TYPE.ghostMicro}`} data-bp="a" data-bp-live aria-hidden="true">—</b>
      <b class={`bp-ghost-q bp-ghost-q-s ${TYPE.ghostLabel}`} data-bp="s" data-bp-live aria-hidden="true">—</b>
      <b class={`bp-ghost-q bp-ghost-q-xy ${TYPE.ghostMicro}`} data-bp="xy" data-bp-live aria-hidden="true">0 · 0</b>
    </div>

    <span class="bp-ghost-r" aria-hidden="true">
      <span class="bp-ghost-r-line"></span>
    </span>
  </div>
</div>

<style>
  .bp-wireframe {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    color: var(--muted-foreground);
    --bp-line: color-mix(in oklab, var(--foreground) 48%, transparent);
    --bp-line-strong: color-mix(in oklab, var(--foreground) 60%, transparent);
    --bp-ink-covered: oklch(0.967 0 0);
    --bp-scale: 1;
  }

  .bp-wireframe.bp-start.bp-covered {
    --bp-line: color-mix(in oklab, var(--bp-ink-covered) 48%, transparent);
    --bp-line-strong: color-mix(in oklab, var(--bp-ink-covered) 60%, transparent);
  }

  .bp-wireframe.bp-start.bp-covered .bp-ghost {
    background-color: color-mix(in oklab, var(--bp-ink-covered) 4%, transparent);
  }

  .bp-wireframe.bp-start.bp-covered .bp-ghost-r-label,
  .bp-wireframe.bp-start.bp-covered .bp-ghost-q {
    color: var(--bp-ink-covered);
  }

  .bp-rect {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--bp-h);
    aspect-ratio: 1122 / 1402;
  }

  .bp-corners {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .bp-corner {
    fill: none;
    stroke: var(--bp-line);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .bp-ghost {
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    width: var(--bp-final-size, 160px);
    height: var(--bp-final-size, 160px);
    translate: -50% 0;
    border: 1px dashed var(--bp-line-strong);
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--foreground) 4%, transparent);
  }

  .bp-ghost-cross {
    position: absolute;
    background-color: var(--bp-line);
  }

  .bp-ghost-cross-x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .bp-ghost-cross-y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .bp-ghost-tick {
    position: absolute;
    width: calc(1rem * var(--bp-scale));
    height: 0;
    border-top: 1px solid var(--bp-line-strong);
  }

  .bp-ghost-tick-top {
    left: 50%;
    top: calc(-1rem * var(--bp-scale));
    translate: -50% 0;
    rotate: 90deg;
  }

  .bp-ghost-tick-bottom {
    left: 50%;
    bottom: calc(-1rem * var(--bp-scale));
    translate: -50% 0;
    rotate: 90deg;
  }

  .bp-ghost-tick-right {
    top: 50%;
    right: calc(-1.5rem * var(--bp-scale));
    translate: 0 -50%;
  }

  .bp-ghost-r {
    position: absolute;
    left: calc(50% - var(--bp-final-size, 160px) / 2 - 1.5rem * var(--bp-scale));
    bottom: calc(0.5rem + var(--bp-final-size, 160px) / 2);
    translate: 0 50%;
  }

  .bp-ghost-r-line {
    display: block;
    width: calc(1rem * var(--bp-scale));
    height: 0;
    border-top: 1px solid var(--bp-line-strong);
  }

  .bp-ghost-r-label,
  .bp-ghost-q {
    position: absolute;
    translate: 0 -50%;
    display: block;
    color: var(--foreground);
    white-space: nowrap;
  }

  .bp-ghost-r-label {
    right: calc(50% + 0.75rem * var(--bp-scale));
    top: 59%;
    text-align: right;
  }

  .bp-ghost-q-a {
    right: calc(50% + 0.5rem * var(--bp-scale));
    top: 41%;
    text-align: right;
  }

  .bp-ghost-q-s,
  .bp-ghost-q-xy {
    left: calc(50% + 0.75rem * var(--bp-scale));
    text-align: left;
  }

  .bp-ghost-q-s {
    top: 41%;
  }

  .bp-ghost-q-xy {
    top: 59%;
    line-height: 1.2;
    white-space: pre-line;
  }
</style>

<script>
  import './morph-measure';
</script>