---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  finalSize?: number;
  finalX?: number;
  finalY?: number;
}

const { src, finalSize = 160, finalX = 0.15, finalY = 0.5 } = Astro.props;
const resolvedSize = `var(--morph-final-size, ${finalSize}px)`;
const centerStyle = {
  left: `min(max(0px, calc(${finalX * 100}% - ${resolvedSize} / 2)), calc(100% - ${resolvedSize}))`,
  top: `min(max(0px, calc(${finalY * 100}% - ${resolvedSize} / 2)), calc(100% - ${resolvedSize}))`,
} as const;
---

<div class="bp-end" data-bp-end aria-hidden="true" style={`--bp-final-size: ${resolvedSize}`}>
  <div class="bp-end-circle" style={centerStyle}>
    <Image
      src={src}
      width={finalSize}
      height={finalSize}
      format="webp"
      fit="cover"
      alt=""
      class="bp-end-img"
    />
    <span class="bp-end-cross bp-end-cross-x" aria-hidden="true"></span>
    <span class="bp-end-cross bp-end-cross-y" aria-hidden="true"></span>
  </div>

  <div class="bp-end-board" style={centerStyle}>
    <span class="bp-end-tick bp-end-tick-top" aria-hidden="true"></span>
    <span class="bp-end-tick bp-end-tick-bottom" aria-hidden="true"></span>
    <span class="bp-end-tick bp-end-tick-left" aria-hidden="true"></span>
    <span class="bp-end-tick bp-end-tick-right" aria-hidden="true"></span>
  </div>
</div>

<style>
  .bp-end {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Tamanho e gap dos traços cardeais: 60% em telas < 768px (círculo
       menor — --morph-final-size 128px) para manter a proporção. */
    --bp-tick-size: 1rem;
    --bp-tick-gap: 1rem;
  }

  @media (max-width: 767px) {
    .bp-end {
      --bp-tick-size: 0.6rem;
      --bp-tick-gap: 0.6rem;
    }
  }

  .bp-end-circle {
    position: absolute;
    z-index: 2;
    width: var(--bp-final-size, 160px);
    height: var(--bp-final-size, 160px);
    border: 1px solid var(--color-primary-foreground);
    border-radius: 9999px;
    overflow: hidden;
  }

  .bp-end-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }

  .bp-end-board {
    position: absolute;
    z-index: 30;
    width: var(--bp-final-size, 160px);
    height: var(--bp-final-size, 160px);
  }

  /* Traços cardeais (mesmo padrão do bp-ghost-tick do hero): 2 verticais
     (topo/base) e 2 horizontais (lados), com gap de 1rem do círculo
     (0.6rem em <768px). Sem rotate — top/bottom usam border-left explícito
     (bbox previsível). Tamanho/gap vêm de --bp-tick-size/--bp-tick-gap. */
  .bp-end-tick {
    position: absolute;
    width: var(--bp-tick-size);
    height: 0;
    border-top: 1px solid color-mix(in oklab, var(--primary) 60%, transparent);
  }

  .bp-end-tick-top,
  .bp-end-tick-bottom {
    width: 0;
    height: var(--bp-tick-size);
    border-top: none;
    border-left: 1px solid color-mix(in oklab, var(--primary) 60%, transparent);
  }

  .bp-end-tick-top {
    left: 50%;
    top: calc(-1 * (var(--bp-tick-gap) + var(--bp-tick-size)));
    translate: -50% 0;
  }

  .bp-end-tick-bottom {
    left: 50%;
    bottom: calc(-1 * (var(--bp-tick-gap) + var(--bp-tick-size)));
    translate: -50% 0;
  }

  .bp-end-tick-left {
    top: 50%;
    left: calc(-1 * (var(--bp-tick-gap) + var(--bp-tick-size)));
    translate: 0 -50%;
  }

  .bp-end-tick-right {
    top: 50%;
    right: calc(-1 * (var(--bp-tick-gap) + var(--bp-tick-size)));
    translate: 0 -50%;
  }

  .bp-end-cross {
    position: absolute;
    background-color: var(--bp-line-strong);
  }

  .bp-end-cross-x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
        background-color: var(--primary-foreground);
  }

  .bp-end-cross-y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background-color: var(--primary-foreground);
  }
</style>