---
import { defaultLocale, ui, type Locale } from '../../i18n/ui';
import { TYPE } from '../ui/typography';

interface Props {
  finalSize?: number;
  finalX?: number;
  finalY?: number;
  locale?: Locale;
}

const { finalSize = 160, finalX = 0.15, finalY = 0.5, locale = defaultLocale } = Astro.props;
const t = ui[locale];
---

<div
  class="bp-board"
  data-bp-wireframe
  data-bp-board
  aria-hidden="true"
  style={`--bp-final-size: var(--morph-final-size, ${finalSize}px)`}
>
  <!-- Legenda no meio da imagem, na camada de baixo: coberta pela foto e
       revelada quando o morph leva a imagem para #sobre-content. -->
  <div class="bp-legend">
    <div class="bp-legend-head">
      <span class={`bp-legend-name ${TYPE.bpLegendName}`}>{t.blueprint.figName}</span>
      <span class={`bp-legend-tag ${TYPE.bpLegendTag}`}>{t.blueprint.morphTag}</span>
    </div>
    <div class="bp-legend-body">
    <dl class="bp-data">
      <div class="bp-group">
        <dt class={`bp-group-title ${TYPE.bpGroupTitle}`}>{t.blueprint.initial}</dt>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>W</dt><dd data-bp="w" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>H</dt><dd data-bp="h" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>d = √(W²+H²)</dt><dd data-bp="d" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>A = W·H</dt><dd data-bp="a" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
      </div>
      <div class="bp-group">
        <dt class={`bp-group-title ${TYPE.bpGroupTitle}`}>{t.blueprint.final}</dt>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>D</dt><dd data-bp="df" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>r</dt><dd data-bp="r" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>A = πr²</dt><dd data-bp="af" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>C = 2πr</dt><dd data-bp="c" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
      </div>
      <div class="bp-group">
        <dt class={`bp-group-title ${TYPE.bpGroupTitle}`}>{t.blueprint.position}</dt>
        <div class="bp-group-row">
          <dt>x·y</dt>
          <dd class={`${TYPE.bpRowValue}`}>{Math.round(finalX * 100)}% · {Math.round(finalY * 100)}%</dd>
        </div>
        <div class="bp-group-row">
          <dt class={`${TYPE.bpRowLabel}`}>s</dt><dd data-bp="s" class={`${TYPE.bpRowValue}`}>—</dd>
        </div>
      </div>
    </dl>
    </div>
  </div>
</div>

<style>
  .bp-board {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    color: var(--muted-foreground);
    --bp-line: color-mix(in oklab, var(--foreground) 48%, transparent);
  }

  .bp-legend {
    position: absolute;
    left: 50%;
    top: calc(var(--bp-h) / 2);
    translate: -50% -50%;
    width: min(16rem, calc(100% - 2rem));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 0.875rem;
    background-color: var(--background);
    color: var(--muted-foreground);
  }


  .bp-legend-head {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 0.75rem;
  }

  .bp-legend-name {
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: color-mix(in oklab, var(--background) 60%, transparent);
    padding: 0.3125rem 0.5rem;
  }

  .bp-legend-tag {
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .bp-legend-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .bp-data {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 0;
    margin: 0;
  }

  .bp-group-title {
    display: block;
    margin-bottom: 0.375rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--primary);
  }

  .bp-group-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .bp-group-row dt {
    color: var(--muted-foreground);
  }

  .bp-group-row dd {
    margin: 0;
    color: var(--foreground);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .bp-legend {
      width: min(16rem, calc(100% - 2rem));
      padding: 0.5rem 0.625rem;
    }

    .bp-legend-head {
      gap: 0.5rem;
      flex-wrap: wrap;
    }
  }
</style>