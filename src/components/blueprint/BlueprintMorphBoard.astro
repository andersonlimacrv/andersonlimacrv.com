---
import { defaultLocale, ui, type Locale } from '../../i18n/ui';

interface Props {
  finalSize?: number;
  finalX?: number;
  finalY?: number;
  locale?: Locale;
}

const { finalSize = 160, finalX = 0.15, finalY = 0.5, locale = defaultLocale } = Astro.props;
const t = ui[locale];
---

<div
  class="bp-board"
  data-bp-wireframe
  data-bp-board
  aria-hidden="true"
  style={`--bp-final-size: var(--morph-final-size, ${finalSize}px)`}
>
  <!-- Legenda no meio da imagem, na camada de baixo: coberta pela foto e
       revelada quando o morph leva a imagem para #sobre-content. -->
  <div class="bp-legend">
    <div class="bp-legend-head">
      <span class="bp-legend-name">{t.blueprint.figName}</span>
      <span class="bp-legend-tag">{t.blueprint.morphTag}</span>
    </div>
    <div class="bp-legend-body">
    <dl class="bp-data">
      <div class="bp-group">
        <dt class="bp-group-title">{t.blueprint.initial}</dt>
        <div class="bp-group-row">
          <dt>W</dt>
          <dd data-bp="w">—</dd>
        </div>
        <div class="bp-group-row">
          <dt>H</dt>
          <dd data-bp="h">—</dd>
        </div>
        <div class="bp-group-row">
          <dt>d = √(W²+H²)</dt>
          <dd data-bp="d">—</dd>
        </div>
        <div class="bp-group-row">
          <dt>A = W·H</dt>
          <dd data-bp="a">—</dd>
        </div>
      </div>
      <div class="bp-group">
        <dt class="bp-group-title">{t.blueprint.final}</dt>
        <div class="bp-group-row">
          <dt>D</dt>
          <dd data-bp="df">—</dd>
        </div>
        <div class="bp-group-row">
          <dt>r</dt>
          <dd data-bp="r">—</dd>
        </div>
        <div class="bp-group-row">
          <dt>A = πr²</dt>
          <dd data-bp="af">—</dd>
        </div>
        <div class="bp-group-row">
          <dt>C = 2πr</dt>
          <dd data-bp="c">—</dd>
        </div>
      </div>
      <div class="bp-group">
        <dt class="bp-group-title">{t.blueprint.position}</dt>
        <div class="bp-group-row">
          <dt>x·y</dt>
          <dd>{Math.round(finalX * 100)}% · {Math.round(finalY * 100)}%</dd>
        </div>
        <div class="bp-group-row">
          <dt>s</dt>
          <dd data-bp="s">—</dd>
        </div>
      </div>
    </dl>
    </div>
  </div>
</div>

<style>
  .bp-board {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    color: var(--muted-foreground);
    --bp-line: color-mix(in oklab, var(--foreground) 48%, transparent);
  }

  .bp-legend {
    position: absolute;
    left: 50%;
    top: calc(var(--bp-h) / 2);
    translate: -50% -50%;
    width: min(16rem, calc(100% - 2rem));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 0.875rem;
    background-color: var(--background);
    font-family: var(--font-mono);
    color: var(--muted-foreground);
  }


  .bp-legend-head {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 0.75rem;
  }

  .bp-legend-name {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: color-mix(in oklab, var(--background) 60%, transparent);
    padding: 0.3125rem 0.5rem;
  }

  .bp-legend-tag {
    font-size: 0.5625rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .bp-legend-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .bp-data {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 0;
    margin: 0;
  }

  .bp-group-title {
    display: block;
    margin-bottom: 0.375rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .bp-group-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.625rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .bp-group-row dt {
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .bp-group-row dd {
    margin: 0;
    color: var(--foreground);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .bp-legend {
      width: min(16rem, calc(100% - 2rem));
      padding: 0.5rem 0.625rem;
    }

    .bp-legend-head {
      gap: 0.5rem;
      flex-wrap: wrap;
    }
  }
</style>